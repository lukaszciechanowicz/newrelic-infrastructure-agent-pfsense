@@ -0,0 +1,39 @@
+#!/bin/sh
+# rc.subr intentionally reads unset rc variables and is not nounset-compatible.
+set -e
+config=/usr/local/etc/newrelic-infra.yml
+# @sample semantics: create only when absent, never overwrite existing secrets.
+# The sample is deliberately not registered as the live configuration file.
+if [ -L "$config" ]; then
+    echo "Refusing symlink configuration: $config" >&2
+    exit 1
+fi
+if [ ! -e "$config" ]; then
+    install -o root -g wheel -m 0600 "$config.sample" "$config"
+fi
+[ -f "$config" ] || { echo "Not a regular configuration: $config" >&2; exit 1; }
+chown root:wheel "$config"
+chmod 0600 "$config"
+install -d -o root -g wheel -m 0750 /var/db/newrelic-infra /var/log/newrelic-infra /var/run/newrelic-infra
+# Normal 'start' respects rc.conf (default NO). Do not start an empty sample.
+# License keys are single-line YAML scalars; strip YAML quoting/comments here.
+if awk '/^[[:space:]]*license_key[[:space:]]*:/ {
+    sub(/^[^:]*:[[:space:]]*/, ""); sub(/[[:space:]]*#.*/, "");
+    gsub(/[\042\047[:space:]]/, ""); if (length($0) > 0) found=1
+} END { exit !found }' "$config"; then
+    # BSD rc helpers use false probes as normal control flow (including test -t).
+    # Keep their standard shell semantics; check actual service failures below.
+    set +e
+    . /etc/rc.subr
+    load_rc_config newrelic_infra
+    : "${newrelic_infra_enable:=NO}"
+    if checkyesno newrelic_infra_enable; then
+        /usr/local/etc/rc.d/newrelic-infra.sh start || exit $?
+    fi
+    load_rc_config newrelic_netflow
+    : "${newrelic_netflow_enable:=NO}"
+    if checkyesno newrelic_netflow_enable; then
+        /usr/local/etc/rc.d/newrelic-netflow-exporter.sh start || exit $?
+    fi
+fi
+# Both services remain disabled unless the administrator explicitly enables them.
