+#!/bin/sh
+# Copyright 2026 New Relic Corporation. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+
+# PROVIDE: newrelic_netflow
+# REQUIRE: NETWORKING newrelic_infra
+# KEYWORD: shutdown
+
+. /etc/rc.subr
+
+name="newrelic_netflow"
+rcvar="newrelic_netflow_enable"
+load_rc_config "${name}"
+
+: "${newrelic_netflow_enable:=NO}"
+: "${newrelic_netflow_interface:=}"
+: "${newrelic_netflow_port:=2055}"
+: "${newrelic_netflow_command:=/usr/local/libexec/newrelic-infra/softflowd}"
+
+command="${newrelic_netflow_command}"
+pidfile="/var/run/newrelic-infra/softflowd.pid"
+command_args="-i ${newrelic_netflow_interface} -n 127.0.0.1:${newrelic_netflow_port} -v 9 -6 -T ip -t maxlife=30 -t expint=5 -p ${pidfile} -c /var/run/newrelic-infra/softflowd.ctl"
+start_precmd="newrelic_netflow_prestart"
+
+newrelic_netflow_prestart()
+{
+	if [ -z "${newrelic_netflow_interface}" ]; then
+		warn "Set newrelic_netflow_interface to one internal pre-NAT observation interface"
+		return 1
+	fi
+	case "${newrelic_netflow_interface}" in
+	lo*)
+		warn "Do not capture loopback: this would also observe flow-export datagrams"
+		return 1
+		;;
+	esac
+	if ! /sbin/ifconfig "${newrelic_netflow_interface}" >/dev/null 2>&1; then
+		warn "Observation interface ${newrelic_netflow_interface} does not exist"
+		return 1
+	fi
+	install -d -m 0750 /var/run/newrelic-infra
+	# pfSense starts local .sh services concurrently. Do not lose the first
+	# export templates by starting the exporter before the local collector.
+	attempt=0
+	while [ "${attempt}" -lt 60 ]; do
+		for agent_pid in $(pgrep -x newrelic-infra); do
+			if /usr/bin/sockstat -4 -l -P udp -p "${newrelic_netflow_port}" |
+			    awk -v pid="${agent_pid}" 'NR > 1 && $3 == pid { found=1 } END { exit !found }'; then
+				return 0
+			fi
+		done
+		attempt=$((attempt + 1))
+		sleep 1
+	done
+	warn "Infrastructure Agent is not listening on UDP ${newrelic_netflow_port}; enable its netflow configuration first"
+	return 1
+}
+
+run_rc_command "$1"
