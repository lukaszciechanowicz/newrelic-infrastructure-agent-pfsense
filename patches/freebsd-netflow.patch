index 0000000000000000000000000000000000000000..f668f49b781be3b461a490bd12e7448e9d03b762
--- /dev/null
+++ b/pkg/metrics/process/sampler_freebsd.go
@@ -0,0 +1,182 @@
+// Copyright 2026 New Relic Corporation. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package process
+
+import (
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/newrelic/infrastructure-agent/internal/agent"
+	"github.com/newrelic/infrastructure-agent/pkg/config"
+	"github.com/newrelic/infrastructure-agent/pkg/helpers"
+	"github.com/newrelic/infrastructure-agent/pkg/metrics"
+	"github.com/newrelic/infrastructure-agent/pkg/metrics/acquire"
+	"github.com/newrelic/infrastructure-agent/pkg/metrics/sampler"
+	"github.com/newrelic/infrastructure-agent/pkg/metrics/types"
+	"github.com/newrelic/infrastructure-agent/pkg/sample"
+	"github.com/shirou/gopsutil/v3/cpu"
+	gprocess "github.com/shirou/gopsutil/v3/process"
+)
+
+type freebsdProcessCounters struct {
+	created int64
+	at      time.Time
+	cpu     cpu.TimesStat
+	io      *gprocess.IOCountersStat
+}
+
+type freebsdProcessSampler struct {
+	context  agent.AgentContext
+	interval time.Duration
+	previous map[int32]freebsdProcessCounters
+}
+
+// NewProcessSampler collects native kern.proc data. CPU and I/O rates require
+// two observations of the same process, identified by PID and creation time.
+func NewProcessSampler(ctx agent.AgentContext) sampler.Sampler {
+	interval := config.FREQ_INTERVAL_FLOOR_PROCESS_METRICS
+	if ctx != nil && ctx.Config() != nil {
+		interval = ctx.Config().MetricsProcessSampleRate
+	}
+	return &freebsdProcessSampler{
+		context:  ctx,
+		interval: time.Duration(interval) * time.Second,
+		previous: make(map[int32]freebsdProcessCounters),
+	}
+}
+
+func (*freebsdProcessSampler) OnStartup()                {}
+func (*freebsdProcessSampler) Name() string              { return "ProcessSampler" }
+func (s *freebsdProcessSampler) Interval() time.Duration { return s.interval }
+func (s *freebsdProcessSampler) Disabled() bool          { return s.interval <= config.FREQ_DISABLE_SAMPLING }
+
+func (s *freebsdProcessSampler) Sample() (sample.EventBatch, error) {
+	// Processes propagates enumeration errors; gopsutil's FreeBSD Pids does not.
+	processes, err := gprocess.Processes()
+	if err != nil {
+		return nil, fmt.Errorf("enumerating FreeBSD processes: %w", err)
+	}
+	next := make(map[int32]freebsdProcessCounters, len(processes))
+	results := make(sample.EventBatch, 0, len(processes))
+	for _, proc := range processes {
+		event, counters, err := s.sampleProcess(proc)
+		if err != nil {
+			mplog.WithError(err).WithField("pid", proc.Pid).Debug("Skipping process.")
+			continue
+		}
+		next[proc.Pid] = counters
+		if event != nil {
+			results = append(results, event)
+		}
+	}
+	s.previous = next
+	return results, nil
+}
+
+func (s *freebsdProcessSampler) sampleProcess(proc *gprocess.Process) (*types.ProcessSample, freebsdProcessCounters, error) {
+	var current freebsdProcessCounters
+	created, err := proc.CreateTime()
+	if err != nil {
+		return nil, current, err
+	}
+	times, err := proc.Times()
+	if err != nil {
+		return nil, current, err
+	}
+	current = freebsdProcessCounters{created: created, at: time.Now(), cpu: *times}
+	current.io, err = proc.IOCounters()
+	if err != nil {
+		mplog.WithError(err).WithField("pid", proc.Pid).Debug("Cannot read process I/O counters.")
+	}
+	previous, found := s.previous[proc.Pid]
+	elapsed := current.at.Sub(previous.at).Seconds()
+	if !found || previous.created != created || elapsed <= 0 || times.User < previous.cpu.User || times.System < previous.cpu.System {
+		return nil, current, nil
+	}
+
+	event, err := s.processGauges(proc)
+	if err != nil {
+		return nil, current, err
+	}
+	event.CPUUserPercent = (times.User - previous.cpu.User) / elapsed * 100
+	event.CPUSystemPercent = (times.System - previous.cpu.System) / elapsed * 100
+	event.CPUPercent = event.CPUUserPercent + event.CPUSystemPercent
+	if current.io != nil {
+		event.IOTotalReadCount = &current.io.ReadCount
+		event.IOTotalWriteCount = &current.io.WriteCount
+		if previous.io != nil {
+			reads := acquire.CalculateSafeDelta(current.io.ReadCount, previous.io.ReadCount, elapsed)
+			writes := acquire.CalculateSafeDelta(current.io.WriteCount, previous.io.WriteCount, elapsed)
+			event.IOReadCountPerSecond = &reads
+			event.IOWriteCountPerSecond = &writes
+		}
+	}
+	// FreeBSD exposes block operation counts, not per-process byte counts.
+	return event, current, nil
+}
+
+func (s *freebsdProcessSampler) processGauges(proc *gprocess.Process) (*types.ProcessSample, error) {
+	var cfg *config.Config
+	if s.context != nil {
+		cfg = s.context.Config()
+	}
+	memory, err := proc.MemoryInfo()
+	if err != nil {
+		return nil, err
+	}
+	if memory.RSS == 0 && (cfg == nil || !cfg.DisableZeroRSSFilter) {
+		return nil, errProcessWithoutRSS
+	}
+	event := metrics.NewProcessSample(proc.Pid)
+	event.Type("ProcessSample")
+	event.MemoryRSSBytes = int64(memory.RSS)
+	event.MemoryVMSBytes = int64(memory.VMS)
+	if event.CommandName, err = proc.Name(); err != nil {
+		return nil, err
+	}
+	if event.ParentProcessID, err = proc.Ppid(); err != nil {
+		return nil, err
+	}
+	if event.ThreadCount, err = proc.NumThreads(); err != nil {
+		return nil, err
+	}
+	status, err := proc.Status()
+	if err != nil {
+		return nil, err
+	}
+	if len(status) > 0 {
+		event.Status = status[0]
+	}
+	strip := config.DefaultStripCommandLine
+	if cfg != nil {
+		strip = cfg.StripCommandLine
+	}
+	if strip {
+		args, err := proc.CmdlineSlice()
+		if err != nil {
+			return nil, err
+		}
+		if len(args) > 0 {
+			event.CmdLine = helpers.SanitizeCommandLine(args[0])
+		}
+	} else {
+		command, err := proc.Cmdline()
+		if err != nil {
+			return nil, err
+		}
+		event.CmdLine = helpers.SanitizeCommandLine(strings.TrimPrefix(command, "-"))
+	}
+	event.User, err = proc.Username()
+	if err != nil {
+		mplog.WithError(err).WithField("pid", proc.Pid).Debug("Cannot read process username.")
+	}
+	event.ProcessDisplayName = event.CommandName
+	if s.context != nil {
+		if name, ok := s.context.GetServiceForPid(int(proc.Pid)); ok && name != "" {
+			event.ProcessDisplayName = name
+		}
+	}
+	return event, nil
+}
diff --git a/pkg/metrics/storage/devstat_freebsd.go b/pkg/metrics/storage/devstat_freebsd.go
new file mode 100644
index 0000000000000000000000000000000000000000..887191c86c3504bd78d67856bb2efb41d301b33e
--- /dev/null
+++ b/pkg/metrics/storage/devstat_freebsd.go
@@ -0,0 +1,84 @@
+// Copyright 2026 New Relic Corporation. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package storage
+
+import (
+	"bytes"
+	"encoding/binary"
+	"fmt"
+	"runtime"
+	"strconv"
+
+	"github.com/shirou/gopsutil/v3/disk"
+	"golang.org/x/sys/unix"
+)
+
+const devstatRecordSize = 288
+
+func freebsdDiskIOCounters() (map[string]IOCountersStat, error) {
+	if runtime.GOARCH != "amd64" {
+		return nil, fmt.Errorf("devstat layout is unsupported on FreeBSD %s", runtime.GOARCH)
+	}
+	version, err := unix.SysctlUint32("kern.devstat.version")
+	if err != nil {
+		return nil, fmt.Errorf("reading devstat version: %w", err)
+	}
+	// This is binary data: Sysctl's string conversion removes a trailing NUL
+	// and corrupts the final record's padding. Always use SysctlRaw.
+	data, err := unix.SysctlRaw("kern.devstat.all")
+	if err != nil {
+		return nil, fmt.Errorf("reading devstat counters: %w", err)
+	}
+	return parseDevstat(data, version)
+}
+
+// parseDevstat decodes DEVSTAT_VERSION 6 from sys/devicestat.h on amd64.
+// The first uint64 is the generation number, followed by fixed-size records.
+func parseDevstat(data []byte, version uint32) (map[string]IOCountersStat, error) {
+	if version != 6 {
+		return nil, fmt.Errorf("unsupported devstat ABI version %d (expected 6)", version)
+	}
+	if len(data) < 8 || (len(data)-8)%devstatRecordSize != 0 {
+		return nil, fmt.Errorf("invalid devstat payload length %d", len(data))
+	}
+	result := make(map[string]IOCountersStat, (len(data)-8)/devstatRecordSize)
+	for record := data[8:]; len(record) > 0; record = record[devstatRecordSize:] {
+		if binary.LittleEndian.Uint32(record[4:8]) == 0 {
+			continue // unallocated devstat entry
+		}
+		deviceType := binary.LittleEndian.Uint32(record[260:264])
+		if deviceType&0x100 != 0 {
+			continue // passthrough devices would duplicate physical disk activity
+		}
+		nameBytes := record[44:60]
+		if end := bytes.IndexByte(nameBytes, 0); end >= 0 {
+			nameBytes = nameBytes[:end]
+		}
+		if len(nameBytes) == 0 {
+			return nil, fmt.Errorf("devstat entry has no device name")
+		}
+		unit := int32(binary.LittleEndian.Uint32(record[60:64]))
+		name := string(nameBytes) + strconv.FormatInt(int64(unit), 10)
+		counter := disk.IOCountersStat{
+			Name:       name,
+			ReadBytes:  binary.LittleEndian.Uint64(record[72:80]),
+			WriteBytes: binary.LittleEndian.Uint64(record[80:88]),
+			ReadCount:  binary.LittleEndian.Uint64(record[104:112]),
+			WriteCount: binary.LittleEndian.Uint64(record[112:120]),
+			ReadTime:   devstatMilliseconds(record[144:160]),
+			WriteTime:  devstatMilliseconds(record[160:176]),
+			IoTime:     devstatMilliseconds(record[192:208]),
+		}
+		result[name] = FreeBSDIOCountersStat{counter}
+	}
+	return result, nil
+}
+
+func devstatMilliseconds(value []byte) uint64 {
+	seconds := binary.LittleEndian.Uint64(value[:8])
+	fraction := binary.LittleEndian.Uint64(value[8:16])
+	// bintime's fraction is in units of 2^-64 seconds. Divide before
+	// multiplying to avoid integer overflow while retaining sub-ms precision.
+	return seconds*1000 + uint64(float64(fraction)*(1000.0/18446744073709551616.0))
+}
