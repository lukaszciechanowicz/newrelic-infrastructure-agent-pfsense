+func TestDecodeTemplateScopes(t *testing.T) {
+	cases := []struct {
+		name     string
+		exporter netip.AddrPort
+		sourceID uint32
+	}{
+		{"exporter address", netip.MustParseAddrPort("192.0.2.101:2055"), 0},
+		{"exporter port", netip.MustParseAddrPort("192.0.2.100:2056"), 0},
+		{"source ID", testExporter, 1},
+		{"maximum source ID", testExporter, math.MaxUint32},
+		{"IPv6 exporter", netip.MustParseAddrPort("[2001:db8::100]:2055"), 0},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			decoder := NewDecoder()
+			_, err := decoder.Decode(testExporter, testPacket(1, 10000, 0,
+				testSet(0, testTemplate(1024, ipv4Fields))), testNow)
+			require.NoError(t, err)
+			got, err := decoder.Decode(tc.exporter, testPacket(1, 10000, tc.sourceID,
+				testSet(1024, sampleIPv4Data(111, 2))), testNow)
+			require.NoError(t, err)
+			assert.Equal(t, Result{UnknownTemplates: 1}, got)
+			fields := []testField{{27, 16}, {28, 16}, {1, 8}, {2, 8}}
+			source := netip.MustParseAddr("2001:db8:1::1")
+			destination := netip.MustParseAddr("2001:db8:2::2")
+			got, err = decoder.Decode(tc.exporter, testPacket(2, 10000, tc.sourceID,
+				testSet(0, testTemplate(1024, fields)),
+				testSet(1024, testData(fields, source, destination, 1<<40, 123))), testNow)
+			require.NoError(t, err)
+			assert.Equal(t, Result{Records: []Record{{Source: source, Destination: destination,
+				Bytes: 1 << 40, Packets: 123}}}, got)
+			got, err = decoder.Decode(testExporter, testPacket(2, 10000, 0,
+				testSet(1024, sampleIPv4Data(1234, 7))), testNow)
+			require.NoError(t, err)
+			assert.Equal(t, Result{Records: []Record{sampleIPv4Record(1234, 7)}}, got)
+		})
+	}
+}
+
+func TestDecodeSequencesAndBootBoundaries(t *testing.T) {
+	type step struct {
+		sequence, uptime   uint32
+		unixOffset         int64
+		unknown, duplicate bool
+		gap                uint64
+	}
+	cases := []struct {
+		name             string
+		sequence, uptime uint32
+		steps            []step
+	}{
+		{"consecutive", 100, 10000, []step{{sequence: 101, uptime: 11000}}},
+		{"gap counts missing datagrams", 100, 10000, []step{{sequence: 104, uptime: 14000, gap: 3}}},
+		{"same sequence different payload", 100, 10000, []step{{sequence: 100, uptime: 10000, duplicate: true}}},
+		{"out of order fills hole once", 100, 10000, []step{
+			{sequence: 102, uptime: 12000, gap: 1}, {sequence: 101, uptime: 11000},
+			{sequence: 101, uptime: 11000, duplicate: true}, {sequence: 103, uptime: 13000},
+		}},
+		{"reordering inside window", 100, 10000, []step{{sequence: 37, uptime: 9000}}},
+		{"older than window", 100, 10000, []step{{sequence: 36, uptime: 9000, duplicate: true}}},
+		{"half range ambiguity is stale", 100, 10000, []step{
+			{sequence: 100 + 1<<31, uptime: 11000, duplicate: true},
+		}},
+		{"sequence wrap", math.MaxUint32 - 1, 10000, []step{
+			{sequence: math.MaxUint32, uptime: 10000}, {sequence: 0, uptime: 10000}, {sequence: 1, uptime: 10000},
+		}},
+		{"sequence gap across wrap", math.MaxUint32 - 1, 10000, []step{{sequence: 1, uptime: 10000, gap: 2}}},
+		{"uptime wrap is not reboot", 100, math.MaxUint32 - 499,
+			[]step{{sequence: 101, uptime: 500}}},
+		{"both counters wrap", math.MaxUint32, math.MaxUint32 - 499,
+			[]step{{sequence: 0, uptime: 500}}},
+		{"immediate restart", 100, 10000, []step{{sequence: 1, uptime: 9999, unknown: true}}},
+		{"uptime regression with forward sequence", 100, 10000,
+			[]step{{sequence: 101, uptime: 9000, unknown: true}}},
+		{"restart without low sequence", 100, 10000, []step{{sequence: 50, uptime: 1, unknown: true}}},
+		{"older export time cannot restart collector", 100, 10000,
+			[]step{{sequence: 1, uptime: 1, unixOffset: -1, duplicate: true}}},
+		{"old boot cannot reuse new templates", 100, 10000, []step{
+			{sequence: 1, uptime: 1, unixOffset: 1, unknown: true},
+			{sequence: 101, uptime: 11000, duplicate: true},
+			{sequence: 2, uptime: 1001, unixOffset: 2, unknown: true},
+		}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			decoder := NewDecoder()
+			_, err := decoder.Decode(testExporter, testPacket(tc.sequence, tc.uptime, 0,
+				testSet(0, testTemplate(1024, ipv4Fields)), testSet(1024, sampleIPv4Data(100, 1))), testNow)
+			require.NoError(t, err)
+			for i, step := range tc.steps {
+				packet := testPacket(step.sequence, step.uptime, 0, testSet(1024, sampleIPv4Data(uint64(i+1000), 10)))
+				binary.BigEndian.PutUint32(packet[8:12], uint32(testNow.Unix()+step.unixOffset))
+				before := snapshotDecoder(decoder)
+				got, err := decoder.Decode(testExporter, packet, testNow.Add(time.Duration(i+1)*time.Second))
+				require.NoError(t, err, "step %d", i)
+				want := Result{SequenceGaps: step.gap}
+				switch {
+				case step.duplicate:
+					want.Duplicate = true
+					assert.Equal(t, before, decoder, "duplicate changed cache or sequence")
+				case step.unknown:
+					want.UnknownTemplates = 1
+				default:
+					want.Records = []Record{sampleIPv4Record(uint64(i+1000), 10)}
+				}
+				assert.Equal(t, want, got, "step %d", i)
+			}
+		})
+	}
+}
+
+func TestDecodeExactReplayDoesNotRefreshAnything(t *testing.T) {
+	decoder := NewDecoder()
+	packet := testPacket(100, 10000, 0, testSet(0, testTemplate(1024, ipv4Fields)),
+		testSet(1024, sampleIPv4Data(1234, 7)))
+	first, err := decoder.Decode(testExporter, packet, testNow)
+	require.NoError(t, err)
+	assert.Equal(t, Result{Records: []Record{sampleIPv4Record(1234, 7)}}, first)
+	before := snapshotDecoder(decoder)
+	got, err := decoder.Decode(testExporter, append([]byte(nil), packet...), testNow.Add(time.Minute))
+	require.NoError(t, err)
+	assert.Equal(t, Result{Duplicate: true}, got)
+	assert.Equal(t, before, decoder)
+}
+
+func TestDecodeReorderedTemplatesDoNotReplaceNewerDefinitions(t *testing.T) {
+	decoder := NewDecoder()
+	_, err := decoder.Decode(testExporter, testPacket(10, 10000, 0,
+		testSet(0, testTemplate(1024, ipv4Fields))), testNow)
+	require.NoError(t, err)
+	fields := []testField{{8, 4}, {12, 4}, {1, 8}, {2, 8}}
+	record := sampleIPv4Record(1<<40, 1<<33)
+	data := testData(fields, record.Source, record.Destination, record.Bytes, record.Packets)
+	got, err := decoder.Decode(testExporter, testPacket(12, 12000, 0,
+		testSet(0, testTemplate(1024, fields)), testSet(1024, data)), testNow.Add(time.Second))
+	require.NoError(t, err)
