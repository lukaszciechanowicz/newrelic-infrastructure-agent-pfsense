+// Copyright 2020 New Relic Corporation. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+package distro
+
+import (
+	"os"
+	"strings"
+
+	"github.com/newrelic/infrastructure-agent/pkg/log"
+	"golang.org/x/sys/unix"
+)
+
+func GetDistro() string {
+	// pfSense provides its product identity separately from the FreeBSD kernel.
+	platform, err := os.ReadFile("/etc/platform")
+	if err == nil && strings.TrimSpace(string(platform)) == "pfSense" {
+		version, err := os.ReadFile("/etc/version")
+		if err == nil && strings.TrimSpace(string(version)) != "" {
+			return "pfSense " + strings.TrimSpace(string(version))
+		}
+	}
+	name, err := unix.Sysctl("kern.ostype")
+	if err != nil {
+		log.WithError(err).Warn("unable to read kernel OS identity")
+		return "FreeBSD"
+	}
+	release, err := unix.Sysctl("kern.osrelease")
+	if err != nil {
+		log.WithError(err).Warn("unable to read kernel OS release")
+		return name
+	}
+	return name + " " + release
+}
+
+func IsCentos5() bool {
+	return false
+}
diff --git a/internal/plugins/freebsd/hostinfo_freebsd.go b/internal/plugins/freebsd/hostinfo_freebsd.go
new file mode 100644
index 0000000000000000000000000000000000000000..3b677e2c55144ebc56478344cc27110830c14a35
--- /dev/null
+++ b/internal/plugins/freebsd/hostinfo_freebsd.go
@@ -0,0 +1,190 @@
+// Copyright 2026 New Relic Corporation. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package freebsd
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/newrelic/infrastructure-agent/internal/agent"
+	"github.com/newrelic/infrastructure-agent/internal/agent/types"
+	"github.com/newrelic/infrastructure-agent/internal/plugins/common"
+	"github.com/newrelic/infrastructure-agent/pkg/entity"
+	"github.com/newrelic/infrastructure-agent/pkg/helpers"
+	"github.com/newrelic/infrastructure-agent/pkg/log"
+	"github.com/newrelic/infrastructure-agent/pkg/plugins/ids"
+	"github.com/shirou/gopsutil/v3/host"
+	"golang.org/x/sys/unix"
+)
+
+var (
+	hlog = log.WithComponent("HostInfoPlugin")
+	// Unlike hw.ncpu, the boot topology distinguishes cores per package from logical CPUs.
+	cpuTopology = regexp.MustCompile(`FreeBSD/SMP: [0-9]+ package\(s\) x ([0-9]+) core\(s\)`)
+)
+
+// HostinfoPlugin returns native FreeBSD and pfSense host metadata.
+type HostinfoPlugin struct {
+	agent.PluginCommon
+	common.HostInfo
+}
+
+// HostInfoFreeBSD uses the same host identity and hardware attributes as the other platforms.
+type HostInfoFreeBSD struct {
+	Distro              string `json:"distro"`
+	KernelVersion       string `json:"kernel_version"`
+	OSVersion           string `json:"os_version"`
+	AgentMode           string `json:"agent_mode"`
+	ProductUuid         string `json:"product_uuid"`
+	common.HostInfoData `mapstructure:",squash"`
+}
+
+func (h *HostInfoFreeBSD) SortKey() string {
+	return h.System
+}
+
+// MarshalJSON preserves flattened OCI labels on the outermost inventory model.
+func (h HostInfoFreeBSD) MarshalJSON() ([]byte, error) {
+	type alias HostInfoFreeBSD
+	data, err := common.FlattenLabels(alias(h), h.OCIFreeformTags)
+	if err != nil {
+		return nil, fmt.Errorf("failed to marshal HostInfoFreeBSD: %w", err)
+	}
+
+	return data, nil
+}
+
+func NewHostinfoPlugin(ctx agent.AgentContext, hostInfo common.HostInfo) agent.Plugin {
+	return &HostinfoPlugin{
+		PluginCommon: agent.PluginCommon{ID: ids.HostInfo, Context: ctx},
+		HostInfo:     hostInfo,
+	}
+}
+
+func (h *HostinfoPlugin) Run() {
+	h.Context.AddReconnecting(h)
+	h.EmitInventory(h.Data(), entity.NewFromNameWithoutID(h.Context.EntityKey()))
+}
+
+func (h *HostinfoPlugin) Data() types.PluginInventoryDataset {
+	return types.PluginInventoryDataset{h.gatherHostinfo()}
+}
+
+func (h *HostinfoPlugin) gatherHostinfo() *HostInfoFreeBSD {
+	commonInfo, err := h.GetHostInfo()
+	if err != nil {
+		hlog.WithError(err).Error("error fetching host data information")
+	}
+
+	data := &HostInfoFreeBSD{
+		HostInfoData:  commonInfo,
+		KernelVersion: sysctlString("kern.osrelease"),
+		AgentMode:     h.Context.Config().RunMode,
+		ProductUuid:   sysctlString("kern.hostuuid"),
+	}
+	data.OperatingSystem, data.OSVersion = operatingSystem(data.KernelVersion, os.ReadFile)
+	data.Distro = strings.TrimSpace(data.OperatingSystem + " " + data.OSVersion)
+	data.CpuName = sysctlString("hw.model")
+
+	if totalCPU, err := unix.SysctlUint32("hw.ncpu"); err != nil {
+		hlog.WithError(err).Error("error reading logical CPU count")
+	} else {
+		data.TotalCpu = strconv.FormatUint(uint64(totalCPU), 10)
+	}
+	if bootLog, err := os.ReadFile("/var/run/dmesg.boot"); err != nil {
+		hlog.WithError(err).Warn("unable to read CPU package topology")
+	} else {
+		data.CpuNum = coresPerPackage(string(bootLog))
+	}
+	if memory, err := unix.SysctlUint64("hw.physmem"); err != nil {
+		hlog.WithError(err).Error("error reading physical memory")
+	} else {
+		data.Ram = fmt.Sprintf("%d kB", memory/1024)
+	}
+	if bootTime, err := host.BootTime(); err != nil {
+		hlog.WithError(err).Error("error reading boot timestamp")
+	} else {
+		data.UpSince = time.Unix(int64(bootTime), 0).Format("2006-01-02 15:04:05")
+	}
+
+	data.HostType, err = h.GetCloudHostType()
+	if errors.Is(err, common.ErrNoCloudHostTypeNotAvailable) {
+		data.HostType = hardwareType()
+	} else if err != nil {
+		hlog.WithError(err).Debug("error getting host type from cloud metadata")
+	}
+
+	helpers.LogStructureDetails(hlog, data, "HostInfoFreeBSD", "raw", nil)
+
+	return data
+}
+
+func sysctlString(name string) string {
+	value, err := unix.Sysctl(name)
+	if err != nil {
+		hlog.WithError(err).WithField("sysctl", name).Error("error reading host metadata")
+		return ""
+	}
+
+	return strings.TrimSpace(value)
+}
+
+// operatingSystem only treats /etc/version as a pfSense release when the platform identifies pfSense.
+// A missing or unreadable release retains the actual FreeBSD kernel version, never an invented release.
+func operatingSystem(kernelVersion string, readFile func(string) ([]byte, error)) (string, string) {
+	platform, err := readFile("/etc/platform")
+	if err != nil {
+		if !errors.Is(err, os.ErrNotExist) {
+			hlog.WithError(err).Warn("unable to read appliance platform")
+		}
+		return "FreeBSD", kernelVersion
+	}
+	if !strings.EqualFold(strings.TrimSpace(string(platform)), "pfSense") {
+		return "FreeBSD", kernelVersion
+	}
+
+	release, err := readFile("/etc/version")
+	if err != nil {
+		hlog.WithError(err).Warn("unable to read pfSense release; reporting FreeBSD kernel version")
+		return "FreeBSD", kernelVersion
+	}
+	version := strings.TrimSpace(string(release))
+	if version == "" {
+		hlog.Warn("pfSense release is empty; reporting FreeBSD kernel version")
+		return "FreeBSD", kernelVersion
+	}
+
+	return "pfSense", version
+}
+
+func coresPerPackage(bootLog string) string {
+	match := cpuTopology.FindStringSubmatch(bootLog)
+	if len(match) != 2 {
+		hlog.Debug("CPU package topology is not available in the boot log")
+		return ""
+	}
+
+	return match[1]
+}
+
+func hardwareType() string {
+	var hardware []string
+	for _, key := range []string{"smbios.system.maker", "smbios.system.product"} {
+		value, err := helpers.RunCommand("/bin/kenv", "", key)
+		if err != nil {
+			hlog.WithError(err).WithField("kenv", key).Debug("unable to read hardware identity")
+			continue
+		}
+		if value = strings.TrimSpace(value); value != "" {
+			hardware = append(hardware, value)
+		}
+	}
+
+	return strings.Join(hardware, " ")
+}
