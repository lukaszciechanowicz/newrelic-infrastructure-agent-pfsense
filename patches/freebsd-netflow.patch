@@ -0,0 +1,36 @@
+#!/bin/sh
+# Copyright 2026 New Relic Corporation. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+# Build the optional exporter separately; the Infrastructure Agent remains pure Go.
+# SOURCE_ARCHIVE is the softflowd-v1.1.1 archive from codeload.github.com/irino/softflowd.
+set -eu
+umask 022
+[ "$(uname -s)" = FreeBSD ] || { echo 'Build the exporter natively on FreeBSD' >&2; exit 1; }
+: "${SOURCE_ARCHIVE:?Set SOURCE_ARCHIVE to the softflowd-v1.1.1 source tar.gz}"
+: "${OUTPUT_DIR:?Set OUTPUT_DIR to an empty output directory}"
+CC=${CC:-cc}
+CPU_FLAGS=${CPU_FLAGS:--march=x86-64}
+GMAKE=${GMAKE:-gmake}
+here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+expected=a6882e59931e5880901f8ee28d78b082cb3000ad8d28af35c13f2b528edbb2c9
+[ "$(sha256 -q "$SOURCE_ARCHIVE")" = "$expected" ] || { echo 'Exporter source SHA-256 mismatch' >&2; exit 1; }
+mkdir -p "$OUTPUT_DIR"
+OUTPUT_DIR=$(CDPATH= cd -- "$OUTPUT_DIR" && pwd)
+[ -z "$(find "$OUTPUT_DIR" -mindepth 1 -maxdepth 1 -print)" ] || { echo 'OUTPUT_DIR must be empty' >&2; exit 1; }
+work=$(mktemp -d "${TMPDIR:-/tmp}/newrelic-softflowd.XXXXXXXX")
+trap 'rm -rf "$work"' EXIT HUP INT TERM
+mkdir "$work/source"
+tar -xzf "$SOURCE_ARCHIVE" -C "$work/source" --strip-components 1
+patch -d "$work/source" -p1 < "$here/softflowd-freebsd.patch"
+cd "$work/source"
+autoreconf -fi
+# Pin the distribution ISA; Zig cc uses CPU_FLAGS=-mcpu=x86_64.
+CC="$CC" CFLAGS="-O2 -g0 $CPU_FLAGS -ffile-prefix-map=$work=softflowd-build" \
+    LDFLAGS="-s" ./configure --prefix=/usr/local
+"$GMAKE" -j "${JOBS:-2}"
+mkdir "$OUTPUT_DIR/bin"
+install -m 0755 softflowd softflowctl "$OUTPUT_DIR/bin/"
+install -m 0644 LICENSE "$OUTPUT_DIR/LICENSE"
+install -m 0644 "$here/softflowd-freebsd.patch" "$OUTPUT_DIR/softflowd-freebsd.patch"
+printf 'softflowd 1.1.1, source SHA-256 %s, immediate capture and self-describing NetFlow v9 datagrams\n' "$expected" > "$OUTPUT_DIR/BUILD.txt"
+printf 'Optional exporter artifacts: %s\n' "$OUTPUT_DIR"
