+// Copyright 2026 New Relic Corporation. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package storage
+
+import (
+	"encoding/binary"
+	"testing"
+
+	"github.com/shirou/gopsutil/v3/disk"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestParseDevstatPreservesTrailingBinaryNUL(t *testing.T) {
+	data := make([]byte, 8+devstatRecordSize)
+	record := data[8:]
+	binary.LittleEndian.PutUint32(record[4:8], 1)
+	copy(record[44:60], "vtbd")
+	binary.LittleEndian.PutUint64(record[72:80], 4096)
+	binary.LittleEndian.PutUint64(record[80:88], 8192)
+	binary.LittleEndian.PutUint64(record[104:112], 2)
+	binary.LittleEndian.PutUint64(record[112:120], 3)
+	binary.LittleEndian.PutUint64(record[144:152], 1)
+	binary.LittleEndian.PutUint64(record[152:160], 1<<63)
+	binary.LittleEndian.PutUint64(record[160:168], 2)
+	binary.LittleEndian.PutUint64(record[192:200], 3)
+	binary.LittleEndian.PutUint64(record[200:208], 1<<63)
+
+	counters, err := parseDevstat(data, 6)
+	require.NoError(t, err)
+	require.Len(t, counters, 1)
+	counter := counters["vtbd0"].(FreeBSDIOCountersStat)
+	assert.Equal(t, uint64(4096), counter.ReadBytes)
+	assert.Equal(t, uint64(8192), counter.WriteBytes)
+	assert.Equal(t, uint64(2), counter.ReadCount)
+	assert.Equal(t, uint64(3), counter.WriteCount)
+	assert.Equal(t, uint64(1500), counter.ReadTime)
+	assert.Equal(t, uint64(2000), counter.WriteTime)
+	assert.Equal(t, uint64(3500), counter.IoTime)
+	assert.Equal(t, "devstat", counter.Source())
+}
+
+func TestParseDevstatRejectsUnsupportedOrMalformedABI(t *testing.T) {
+	cases := []struct {
+		name    string
+		data    []byte
+		version uint32
+	}{
+		{"unknown version", make([]byte, 8), 7},
+		{"missing generation", nil, 6},
+		{"truncated binary padding", make([]byte, 8+devstatRecordSize-1), 6},
+		{"nameless allocated record", make([]byte, 8+devstatRecordSize), 6},
+	}
+	binary.LittleEndian.PutUint32(cases[3].data[12:16], 1)
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			counters, err := parseDevstat(tc.data, tc.version)
+			require.Error(t, err)
+			assert.Nil(t, counters)
+		})
+	}
+}
+
+func TestFreeBSDStorageCounterAvailability(t *testing.T) {
+	wrapper := &FreeBSDStorageSampleWrapper{}
+	old := FreeBSDIOCountersStat{disk.IOCountersStat{
+		ReadCount: 10, WriteCount: 20, ReadBytes: 100, WriteBytes: 200,
+		ReadTime: 100, WriteTime: 200, IoTime: 300,
+	}}
+	cases := []struct {
+		name      string
+		counter   FreeBSDIOCountersStat
+		elapsed   int64
+		available bool
+	}{
+		{"measured idle", old, 1000, true},
+		{"baseline has no rate", old, 0, false},
+		{"reset counters", FreeBSDIOCountersStat{disk.IOCountersStat{}}, 1000, false},
+		{"only busy time reset", FreeBSDIOCountersStat{disk.IOCountersStat{
+			ReadCount: 10, WriteCount: 20, ReadBytes: 100, WriteBytes: 200,
+			ReadTime: 100, WriteTime: 200, IoTime: 1,
+		}}, 1000, false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			result := wrapper.CalculateSampleValues(tc.counter, old, tc.elapsed)
+			assert.Equal(t, tc.available, result.ReadsPerSec != nil)
+			assert.Equal(t, tc.available, result.TotalUtilizationPercent != nil)
+			assert.Nil(t, result.ReadUtilizationPercent)
+			assert.Nil(t, result.WriteUtilizationPercent)
+			if tc.available {
+				assert.Zero(t, *result.ReadsPerSec)
+				assert.Zero(t, *result.TotalUtilizationPercent)
+			}
+		})
+	}
+}
+
+func TestDeviceMappingFollowsGEOMLabelsWithoutDuplicatingDiskIO(t *testing.T) {
+	topology := "0 DISK vtbd0 21474836480 512\n" +
+		"1 PART vtbd0p2 20128464896 512\n" +
+		"2 LABEL ufsid/root 20128464896 512\n" +
+		"1 PART vtbd0p1 272629760 512\n\x00"
+	mapping, err := deviceMappingFromGEOM(topology, map[string]bool{"/dev/ufsid/root": true})
+	require.NoError(t, err)
+	assert.Equal(t, "/dev/ufsid/root", mapping["vtbd0"])
+	assert.Equal(t, "/dev/ufsid/root", mapping["vtbd0p2"])
+
+	mapping, err = deviceMappingFromGEOM(topology, map[string]bool{
+		"/dev/ufsid/root": true,
+		"/dev/vtbd0p1":    true,
+	})
+	require.NoError(t, err)
+	assert.NotContains(t, mapping, "vtbd0")
+	assert.Equal(t, "/dev/ufsid/root", mapping["vtbd0p2"])
+	assert.Equal(t, "/dev/vtbd0p1", mapping["vtbd0p1"])
+}
+
+func TestDeviceMappingRejectsMalformedTopology(t *testing.T) {
+	_, err := deviceMappingFromGEOM("2 LABEL orphan 1 512", map[string]bool{"/dev/orphan": true})
+	require.Error(t, err)
+}
