diff --git a/cmd/newrelic-infra/initialize/initialize_freebsd.go b/cmd/newrelic-infra/initialize/initialize_freebsd.go
new file mode 100644
index 0000000000000000000000000000000000000000..c47445c6766575f7917abb0a99a1b2b3afcac644
--- /dev/null
+++ b/cmd/newrelic-infra/initialize/initialize_freebsd.go
@@ -0,0 +1,79 @@
+// Copyright 2020 New Relic Corporation. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+package initialize
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strconv"
+	"syscall"
+
+	"github.com/newrelic/infrastructure-agent/pkg/config"
+)
+
+const agentTemporaryFolder = "/var/db/newrelic-infra/tmp"
+
+// Keep the locked descriptor open for the lifetime of the agent. The kernel
+// releases the lock on exit, including abnormal termination.
+var pidFileLock *os.File
+
+// AgentService validates the integrations workspace before starting the agent.
+func AgentService(cfg *config.Config) error {
+	return assertTempFolderOwnership(cfg)
+}
+
+// OsProcess reserves the configured PID file unless a service manager owns it.
+func OsProcess(cfg *config.Config) error {
+	if os.Getenv("PIDFILE") != "" {
+		return nil
+	}
+	return verifySingularity(cfg.PidFile)
+}
+
+func verifySingularity(pidfile string) error {
+	if err := os.MkdirAll(filepath.Dir(pidfile), 0o755); err != nil {
+		return fmt.Errorf("create pid-file directory: %w", err)
+	}
+	fd, err := syscall.Open(pidfile, syscall.O_RDWR|syscall.O_CREAT|syscall.O_NOFOLLOW|syscall.O_CLOEXEC, 0o644)
+	if err != nil {
+		return fmt.Errorf("open pid-file: %w", err)
+	}
+	file := os.NewFile(uintptr(fd), pidfile)
+	if err := syscall.Flock(fd, syscall.LOCK_EX|syscall.LOCK_NB); err != nil {
+		_ = file.Close()
+		return fmt.Errorf("lock pid-file (another agent may be running): %w", err)
+	}
+	if err := file.Truncate(0); err != nil {
+		_ = file.Close()
+		return fmt.Errorf("truncate pid-file: %w", err)
+	}
+	if _, err := file.WriteString(strconv.Itoa(os.Getpid()) + "\n"); err != nil {
+		_ = file.Close()
+		return fmt.Errorf("write pid-file: %w", err)
+	}
+	pidFileLock = file
+	return nil
+}
+
+func assertTempFolderOwnership(cfg *config.Config) error {
+	folder := cfg.DefaultIntegrationsTempDir
+	if err := os.MkdirAll(folder, 0o755); err != nil {
+		return fmt.Errorf("create integrations temporary directory: %w", err)
+	}
+	info, err := os.Lstat(folder)
+	if err != nil {
+		return fmt.Errorf("inspect integrations temporary directory: %w", err)
+	}
+	if !info.IsDir() {
+		return fmt.Errorf("integrations temporary path %q is not a directory", folder)
+	}
+	stat, ok := info.Sys().(*syscall.Stat_t)
+	if !ok {
+		return fmt.Errorf("cannot determine owner of integrations temporary directory %q", folder)
+	}
+	if stat.Uid != uint32(os.Geteuid()) {
+		return fmt.Errorf("integrations temporary directory %q belongs to uid %d, expected %d", folder, stat.Uid, os.Geteuid())
+	}
+	return nil
+}
diff --git a/cmd/newrelic-infra/initialize/initialize_freebsd_test.go b/cmd/newrelic-infra/initialize/initialize_freebsd_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..d56940b85fbf0b7a4a98cf4de20cc96467c3cc12
--- /dev/null
+++ b/cmd/newrelic-infra/initialize/initialize_freebsd_test.go
@@ -0,0 +1,58 @@
+// Copyright 2020 New Relic Corporation. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+package initialize
+
+import (
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/newrelic/infrastructure-agent/pkg/config"
+	"github.com/stretchr/testify/require"
+)
+
+func TestFreeBSDSingletonLock(t *testing.T) {
+	pidfile := filepath.Join(t.TempDir(), "agent.pid")
+	// An unlocked file from an exited process must not prevent startup.
+	require.NoError(t, os.WriteFile(pidfile, []byte("123456789\n"), 0o644))
+	require.NoError(t, verifySingularity(pidfile))
+	t.Cleanup(func() {
+		require.NoError(t, pidFileLock.Close())
+		pidFileLock = nil
+	})
+	content, err := os.ReadFile(pidfile)
+	require.NoError(t, err)
+	require.Equal(t, strconv.Itoa(os.Getpid()), strings.TrimSpace(string(content)))
+	// A competing open must fail without corrupting the owner's PID.
+	require.ErrorContains(t, verifySingularity(pidfile), "lock pid-file")
+	content, err = os.ReadFile(pidfile)
+	require.NoError(t, err)
+	require.Equal(t, strconv.Itoa(os.Getpid()), strings.TrimSpace(string(content)))
+}
+
+func TestFreeBSDSingletonRejectsSymlink(t *testing.T) {
+	dir := t.TempDir()
+	target := filepath.Join(dir, "target")
+	require.NoError(t, os.WriteFile(target, []byte("preserve"), 0o644))
+	pidfile := filepath.Join(dir, "agent.pid")
+	require.NoError(t, os.Symlink(target, pidfile))
+	require.Error(t, verifySingularity(pidfile))
+	content, err := os.ReadFile(target)
+	require.NoError(t, err)
+	require.Equal(t, "preserve", string(content))
+}
+
+func TestFreeBSDIntegrationsWorkspace(t *testing.T) {
+	dir := t.TempDir()
+	workspace := filepath.Join(dir, "workspace")
+	cfg := &config.Config{DefaultIntegrationsTempDir: workspace}
+	require.NoError(t, assertTempFolderOwnership(cfg))
+	require.NoError(t, assertTempFolderOwnership(cfg))
+
+	link := filepath.Join(dir, "link")
+	require.NoError(t, os.Symlink(workspace, link))
+	cfg.DefaultIntegrationsTempDir = link
+	require.ErrorContains(t, assertTempFolderOwnership(cfg), "not a directory")
+}
