index 0000000000000000000000000000000000000000..9f79ebf96e8053125d3ef2712abd1c2051d8d8db
--- /dev/null
+++ b/internal/agent/debug/debug_freebsd.go
@@ -0,0 +1,43 @@
+// Copyright 2020 New Relic Corporation. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+package debug
+
+import (
+	"encoding/binary"
+	"fmt"
+	"os"
+
+	"golang.org/x/sys/unix"
+)
+
+func init() {
+	ProvideFn = func() (string, error) {
+		count, err := fileDescriptorCount()
+		return fmt.Sprintf("resource usage report: bytes allocated: %d file descriptors: %d", memAllocBytes(), count), err
+	}
+}
+
+func fileDescriptorCount() (int, error) {
+	data, err := unix.SysctlRaw("kern.proc.filedesc", os.Getpid())
+	if err != nil {
+		return -1, fmt.Errorf("read agent file descriptors: %w", err)
+	}
+	count := 0
+	for len(data) > 0 {
+		// sys/user.h defines the stable prefix of each variable-size
+		// kinfo_file record as int kf_structsize, kf_type, kf_fd.
+		if len(data) < 12 {
+			return -1, fmt.Errorf("truncated kinfo_file header: %d bytes", len(data))
+		}
+		size := int(binary.NativeEndian.Uint32(data[:4]))
+		if size < 12 || size > len(data) {
+			return -1, fmt.Errorf("invalid kinfo_file record size %d in %d bytes", size, len(data))
+		}
+		// Negative descriptors are cwd/root/text references, not open FDs.
+		if int32(binary.NativeEndian.Uint32(data[8:12])) >= 0 {
+			count++
+		}
+		data = data[size:]
+	}
+	return count, nil
+}
