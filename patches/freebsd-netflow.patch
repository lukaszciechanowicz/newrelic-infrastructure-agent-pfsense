+// Copyright 2020 New Relic Corporation. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+package agent
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+
+	"github.com/newrelic/infrastructure-agent/internal/os/distro"
+)
+
+func GenerateUserAgent(what, version string) string {
+	debugData := map[string]string{"os": distro.GetDistro()}
+	hostname, err := os.Hostname()
+	if err != nil {
+		hostname = "unknown"
+	}
+	debugData["host"] = hostname
+	data, _ := json.Marshal(debugData) // A map of strings cannot fail to marshal.
+	return fmt.Sprintf("%s version %s %s", what, version, data)
+}
