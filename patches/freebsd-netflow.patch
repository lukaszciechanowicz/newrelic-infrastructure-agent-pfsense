+// Copyright 2026 New Relic Corporation. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package metrics
+
+import (
+	"encoding/json"
+
+	"github.com/newrelic/infrastructure-agent/pkg/sample"
+)
+
+// MarshalJSON keeps the shared sampling API while omitting attributes FreeBSD
+// cannot measure. A marshaler on an embedded CPU/Memory/DiskSample would instead
+// capture SystemSample's entire JSON representation and lose sibling metrics.
+func (s *SystemSample) MarshalJSON() ([]byte, error) {
+	wire := struct {
+		sample.BaseEvent
+		*CPUSample
+		*LoadSample
+		*MemorySample
+		*HostSample
+		HostID             string   `json:"host.id,omitempty"`
+		CPUIOWaitPercent   *float64 `json:"cpuIOWaitPercent,omitempty"`
+		CPUStealPercent    *float64 `json:"cpuStealPercent,omitempty"`
+		MemoryCachedBytes  *float64 `json:"memoryCachedBytes,omitempty"`
+		MemorySlabBytes    *float64 `json:"memorySlabBytes,omitempty"`
+		MemorySharedBytes  *float64 `json:"memorySharedBytes,omitempty"`
+		UsedBytes          *float64 `json:"diskUsedBytes,omitempty"`
+		UsedPercent        *float64 `json:"diskUsedPercent,omitempty"`
+		FreeBytes          *float64 `json:"diskFreeBytes,omitempty"`
+		FreePercent        *float64 `json:"diskFreePercent,omitempty"`
+		TotalBytes         *float64 `json:"diskTotalBytes,omitempty"`
+		UtilizationPercent *float64 `json:"diskUtilizationPercent,omitempty"`
+		ReadsPerSec        *float64 `json:"diskReadsPerSecond,omitempty"`
+		WritesPerSec       *float64 `json:"diskWritesPerSecond,omitempty"`
+	}{
+		BaseEvent:    s.BaseEvent,
+		CPUSample:    s.CPUSample,
+		LoadSample:   s.LoadSample,
+		MemorySample: s.MemorySample,
+		HostSample:   s.HostSample,
+		HostID:       s.HostID,
+	}
+	if s.CPUSample == defaultCPUSample {
+		// The first observation establishes a counter baseline, not zero load.
+		wire.CPUSample = nil
+	}
+	if disk := s.DiskSample; disk != nil {
+		if disk.capacityAvailable {
+			wire.UsedBytes = &disk.UsedBytes
+			wire.UsedPercent = &disk.UsedPercent
+			wire.FreeBytes = &disk.FreeBytes
+			wire.FreePercent = &disk.FreePercent
+			wire.TotalBytes = &disk.TotalBytes
+		}
+		if disk.ioAvailable {
+			wire.UtilizationPercent = &disk.UtilizationPercent
+			wire.ReadsPerSec = &disk.ReadsPerSec
+			wire.WritesPerSec = &disk.WritesPerSec
+		}
+	}
+	return json.Marshal(&wire)
+}
