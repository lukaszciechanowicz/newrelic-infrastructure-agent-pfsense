@@ -0,0 +1,87 @@
+// Copyright 2026 New Relic Corporation. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package freebsd
+
+import (
+	"encoding/json"
+	"os"
+	"testing"
+
+	"github.com/newrelic/infrastructure-agent/internal/plugins/common"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestOperatingSystem(t *testing.T) {
+	cases := []struct {
+		name     string
+		platform string
+		release  string
+		readErr  error
+		wantOS   string
+		wantVer  string
+	}{
+		{"pfSense release", "pfSense\n", "2.9.0-RELEASE\n", nil, "pfSense", "2.9.0-RELEASE"},
+		{"plain FreeBSD", "", "", os.ErrNotExist, "FreeBSD", "16.0-CURRENT"},
+		{"other appliance", "other", "2.9.0", nil, "FreeBSD", "16.0-CURRENT"},
+		{"missing release", "pfSense", "", os.ErrNotExist, "FreeBSD", "16.0-CURRENT"},
+		{"unreadable release", "pfSense", "", os.ErrPermission, "FreeBSD", "16.0-CURRENT"},
+		{"empty release", "pfSense", " \n", nil, "FreeBSD", "16.0-CURRENT"},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			readFile := func(path string) ([]byte, error) {
+				if path == "/etc/platform" {
+					if tc.platform == "" {
+						return nil, tc.readErr
+					}
+					return []byte(tc.platform), nil
+				}
+				assert.Equal(t, "/etc/version", path)
+				return []byte(tc.release), tc.readErr
+			}
+
+			name, version := operatingSystem("16.0-CURRENT", readFile)
+			assert.Equal(t, tc.wantOS, name)
+			assert.Equal(t, tc.wantVer, version)
+		})
+	}
+}
+
+func TestCoresPerPackage(t *testing.T) {
+	assert.Equal(t, "2", coresPerPackage("FreeBSD/SMP: 1 package(s) x 2 core(s)\n"))
+	assert.Equal(t, "8", coresPerPackage("FreeBSD/SMP: 2 package(s) x 8 core(s) x 2 hardware threads\n"))
+	assert.Empty(t, coresPerPackage("FreeBSD/SMP: Multiprocessor System Detected: 2 CPUs\n"))
+}
+
+func TestHostInfoJSONPreservesPlatformAndLabels(t *testing.T) {
+	info := HostInfoFreeBSD{
+		Distro:        "pfSense 2.9.0-RELEASE",
+		KernelVersion: "16.0-CURRENT",
+		OSVersion:     "2.9.0-RELEASE",
+		ProductUuid:   "517e59d7-a7f1-495b-84b6-fac519daa789",
+		HostInfoData: common.HostInfoData{
+			System:          "system",
+			OperatingSystem: "pfSense",
+			CloudData: common.CloudData{
+				OracleCloudData: common.OracleCloudData{
+					OCIFreeformTags: map[string]string{"environment": "production"},
+				},
+			},
+		},
+	}
+	encoded, err := json.Marshal(info)
+	require.NoError(t, err)
+
+	var fields map[string]interface{}
+	require.NoError(t, json.Unmarshal(encoded, &fields))
+	assert.Equal(t, "system", fields["id"])
+	assert.Equal(t, "pfSense", fields["operating_system"])
+	assert.Equal(t, "pfSense 2.9.0-RELEASE", fields["distro"])
+	assert.Equal(t, "16.0-CURRENT", fields["kernel_version"])
+	assert.Equal(t, "2.9.0-RELEASE", fields["os_version"])
+	assert.Equal(t, info.ProductUuid, fields["product_uuid"])
+	assert.Equal(t, "production", fields["label.environment"])
+}
