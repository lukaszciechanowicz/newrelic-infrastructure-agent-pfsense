@@ -0,0 +1,47 @@
+// Copyright 2026 New Relic Corporation. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package metrics
+
+import (
+	"github.com/shirou/gopsutil/v3/mem"
+	"golang.org/x/sys/unix"
+)
+
+func NewMemoryMonitor(_ bool) *MemoryMonitor {
+	return &MemoryMonitor{vmHarvest: mem.VirtualMemory}
+}
+
+func swapMemory() (*SwapSample, error) {
+	devices, err := unix.SysctlUint32("vm.nswapdev")
+	if err != nil {
+		return nil, err
+	}
+	if devices == 0 {
+		// A machine with no configured swap really has zero swap capacity.
+		// gopsutil reports this configuration as an error, not a measurement.
+		return &SwapSample{}, nil
+	}
+	swap, err := mem.SwapMemory()
+	if err != nil {
+		return nil, err
+	}
+	return &SwapSample{
+		SwapTotal: float64(swap.Total),
+		SwapFree:  float64(swap.Free),
+		SwapUsed:  float64(swap.Used),
+	}, nil
+}
+
+func memorySample(memory *mem.VirtualMemoryStat, swap *SwapSample, freePercent, usedPercent float64) (*MemorySample, error) {
+	return &MemorySample{
+		MemoryTotal:       float64(memory.Total),
+		MemoryFree:        float64(memory.Available),
+		MemoryUsed:        float64(memory.Used),
+		MemoryFreePercent: freePercent,
+		MemoryUsedPercent: usedPercent,
+		MemoryBuffers:     floatToReference(float64(memory.Buffers)),
+		MemoryKernelFree:  floatToReference(float64(memory.Free)),
+		SwapSample:        *swap,
+	}, nil
+}
