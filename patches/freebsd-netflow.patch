--- /dev/null
+++ b/build/package/freebsd/pkg-pre-install.sh
@@ -0,0 +1,38 @@
+#!/bin/sh
+# Stop the supervisor before pkg replaces files. Never alter user data or keys.
+set -eu
+config=/usr/local/etc/newrelic-infra.yml
+if [ -L "$config" ]; then
+    echo "Refusing symlink configuration: $config" >&2
+    exit 1
+fi
+if [ -f "$config" ]; then
+    chown root:wheel "$config"
+    chmod 0600 "$config"
+fi
+for service_file in newrelic-netflow-exporter.sh newrelic-infra.sh; do
+    service_path="/usr/local/etc/rc.d/$service_file"
+    if [ -x "$service_path" ] && "$service_path" onestatus >/dev/null 2>&1; then
+        "$service_path" onestop
+        if "$service_path" onestatus >/dev/null 2>&1; then
+            echo "Service did not stop; refusing replacement: $service_file" >&2
+            exit 1
+        fi
+    fi
+done
+# Unlink, never truncate: even a manually started binary may still be mapped.
+# pkg extracts new inodes, avoiding ETXTBSY without killing unrelated processes.
+for binary in newrelic-infra newrelic-infra-ctl newrelic-infra-service; do
+    path="/usr/local/bin/$binary"
+    if [ -e "$path" ] || [ -L "$path" ]; then
+        [ ! -d "$path" ] || { echo "Refusing directory: $path" >&2; exit 1; }
+        rm -f "$path"
+    fi
+done
+for binary in softflowd softflowctl; do
+    path="/usr/local/libexec/newrelic-infra/$binary"
+    if [ -e "$path" ]; then
+        [ ! -d "$path" ] || { echo "Refusing directory: $path" >&2; exit 1; }
+        rm -f "$path"
+    fi
+done
diff --git a/build/package/freebsd/release.sh b/build/package/freebsd/release.sh
new file mode 100755
index 0000000000000000000000000000000000000000..9ce74beb80d5d20659856a456a0bf1160b94fbc2
--- /dev/null
+++ b/build/package/freebsd/release.sh
@@ -0,0 +1,98 @@
+#!/bin/sh
+# Copyright 2026 New Relic Corporation. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+# Usage: GO_BIN=/path/to/go OUTPUT_DIR=/path/to/new-output ./release.sh [tar|pkg]
+# tar may cross compile; pkg must run on FreeBSD/amd64 with pkg installed.
+set -eu
+umask 022
+mode=${1:-tar}
+case "$mode" in tar|pkg) ;; *) echo 'usage: release.sh [tar|pkg]' >&2; exit 1 ;; esac
+here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+repo=$(CDPATH= cd -- "$here/../../.." && pwd)
+VERSION=${VERSION:-1.80.6-freebsd.2}
+PKG_VERSION=${PKG_VERSION:-1.80.6_2}
+GO_BIN=${GO_BIN:-go}
+OUTPUT_DIR=${OUTPUT_DIR:-"$repo/dist/freebsd-$VERSION"}
+: "${EXPORTER_DIR:?Build the patched exporter first and set EXPORTER_DIR}"
+for file in bin/softflowd bin/softflowctl LICENSE BUILD.txt softflowd-freebsd.patch; do
+    [ -f "$EXPORTER_DIR/$file" ] || { echo "Missing exporter artifact: $file" >&2; exit 1; }
+done
+EXPORTER_DIR=$(CDPATH= cd -- "$EXPORTER_DIR" && pwd)
+# Values are embedded in linker flags or UCL; reject metacharacters.
+for value in "$VERSION" "$PKG_VERSION"; do
+    case "$value" in ''|*[!A-Za-z0-9._+-]*) echo 'invalid release version' >&2; exit 1 ;; esac
+done
+if [ "$mode" = pkg ]; then
+    [ "$(uname -s)" = FreeBSD ] && [ "$(uname -m)" = amd64 ] || {
+        echo 'native packages must be built on FreeBSD/amd64' >&2; exit 1;
+    }
+    command -v pkg >/dev/null
+fi
+cd "$repo"
+GIT_COMMIT=${GIT_COMMIT:-$(git rev-parse HEAD)}
+case "$GIT_COMMIT" in ''|*[!A-Za-z0-9._+-]*) echo 'invalid GIT_COMMIT' >&2; exit 1 ;; esac
+SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH:-$(git show -s --format=%ct HEAD)}
+case "$SOURCE_DATE_EPOCH" in ''|*[!0-9]*) echo 'invalid SOURCE_DATE_EPOCH' >&2; exit 1 ;; esac
+# An absent/empty destination is required; never delete or overwrite an existing release.
+mkdir -p "$OUTPUT_DIR"
+OUTPUT_DIR=$(CDPATH= cd -- "$OUTPUT_DIR" && pwd)
+[ -z "$(find "$OUTPUT_DIR" -mindepth 1 -maxdepth 1 -print)" ] || {
+    echo 'OUTPUT_DIR must be empty' >&2; exit 1;
+}
+work=$(mktemp -d "${TMPDIR:-/tmp}/newrelic-freebsd.XXXXXXXX")
+trap 'rm -rf "$work"' EXIT HUP INT TERM
+stage="$work/stage"
+mkdir -p "$OUTPUT_DIR/bin" "$stage/usr/local/bin" "$stage/usr/local/etc/rc.d" "$stage/usr/local/share/newrelic-infra"
+mkdir -p "$stage/usr/local/libexec/newrelic-infra" "$stage/usr/local/share/newrelic-infra/softflowd"
+export GOOS=freebsd GOARCH=amd64 CGO_ENABLED=0 GOTOOLCHAIN=local SOURCE_DATE_EPOCH
+for binary in newrelic-infra newrelic-infra-ctl newrelic-infra-service; do
+    "$GO_BIN" build -mod=readonly -trimpath -buildvcs=false \
+        -ldflags "-s -w -X main.buildVersion=$VERSION -X main.gitCommit=$GIT_COMMIT -X main.buildDate=$SOURCE_DATE_EPOCH" \
+        -o "$OUTPUT_DIR/bin/$binary" "./cmd/$binary"
+    install -m 0755 "$OUTPUT_DIR/bin/$binary" "$stage/usr/local/bin/$binary"
+done
+install -m 0755 "$here/newrelic-infra.sh" "$stage/usr/local/etc/rc.d/newrelic-infra.sh"
+install -m 0755 "$here/newrelic-netflow-exporter.sh" "$stage/usr/local/etc/rc.d/newrelic-netflow-exporter.sh"
+install -m 0755 "$EXPORTER_DIR/bin/softflowd" "$EXPORTER_DIR/bin/softflowctl" "$stage/usr/local/libexec/newrelic-infra/"
+install -m 0644 "$EXPORTER_DIR/LICENSE" "$EXPORTER_DIR/BUILD.txt" "$EXPORTER_DIR/softflowd-freebsd.patch" "$stage/usr/local/share/newrelic-infra/softflowd/"
+install -m 0644 "$repo/AGENT.md" "$stage/usr/local/share/newrelic-infra/AGENT.md"
+install -m 0600 "$here/newrelic-infra.yml.sample" "$stage/usr/local/etc/newrelic-infra.yml.sample"
+install -m 0644 "$repo/LICENSE" "$stage/usr/local/share/newrelic-infra/LICENSE"
+install -m 0644 "$repo/THIRD_PARTY_NOTICES.md" "$stage/usr/local/share/newrelic-infra/THIRD_PARTY_NOTICES.md"
+# Tar contains an install tree, not an installer: review config before enabling rc.d.
+tar -czf "$OUTPUT_DIR/newrelic-infra-freebsd-${VERSION}-amd64.tar.gz" -C "$stage" usr
+if [ "$mode" = pkg ]; then
+    meta="$work/meta"
+    mkdir "$meta"
+    cat > "$meta/+MANIFEST" <<EOF
+name: "newrelic-infra-freebsd"
+version: "$PKG_VERSION"
+origin: "sysutils/newrelic-infra-freebsd"
+comment: "New Relic Infrastructure Agent for FreeBSD"
+desc: "Community FreeBSD Infrastructure Agent port with optional NetFlow v9 accounting and a patched softflowd exporter."
+www: "https://github.com/newrelic/infrastructure-agent"
+maintainer: "community-port@localhost"
+prefix: "/usr/local"
+licenselogic: "multi"
+licenses: ["APACHE20", "BSD2CLAUSE", "BSD3CLAUSE"]
+EOF
+    install -m 0644 "$here/pkg-pre-install.sh" "$meta/+PRE_INSTALL"
+    install -m 0644 "$here/pkg-pre-install.sh" "$meta/+PRE_UPGRADE"
+    install -m 0644 "$here/pkg-post-install.sh" "$meta/+POST_INSTALL"
+    install -m 0644 "$here/pkg-post-install.sh" "$meta/+POST_UPGRADE"
+    install -m 0644 "$here/pkg-pre-deinstall.sh" "$meta/+PRE_DEINSTALL"
+    # Explicit root ownership does not require building as root.
+    pkg create -m "$meta" -p "$here/pkg-plist" -r "$stage" -o "$OUTPUT_DIR" -t "$SOURCE_DATE_EPOCH"
+fi
+(
+    cd "$OUTPUT_DIR"
+    for file in bin/* *.tar.gz *.pkg; do
+        [ -f "$file" ] || continue
+        if command -v sha256 >/dev/null 2>&1; then
+            printf '%s  %s\n' "$(sha256 -q "$file")" "$file"
+        else
+            shasum -a 256 "$file"
+        fi
+    done
+) > "$OUTPUT_DIR/SHA256SUMS"
+printf 'Release artifacts: %s\n' "$OUTPUT_DIR"
