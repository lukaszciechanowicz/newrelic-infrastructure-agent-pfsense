+package legacy
+
+import "os/exec"
+
+// newCmd preserves the integration user using the standard FreeBSD sudo path.
+// Configuring an integration user therefore requires the sudo package.
+func (ep *externalPlugin) newCmd(executable string, args []string) *exec.Cmd {
+	integrationUser := ep.pluginInstance.IntegrationUser
+	if integrationUser == "" {
+		return exec.Command(executable, args...)
+	}
+	sudoArgs := append([]string{"-E", "-n", "-u", integrationUser, executable}, args...)
+	return exec.Command("/usr/local/bin/sudo", sudoArgs...)
+}
