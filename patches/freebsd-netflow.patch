@@ -0,0 +1,84 @@
+// Copyright 2026 New Relic Corporation. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package metrics
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/newrelic/infrastructure-agent/pkg/helpers/metric"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestFreeBSDSystemSampleOmitsUnsupportedMetrics(t *testing.T) {
+	event := &SystemSample{
+		CPUSample:    &CPUSample{CPUPercent: 25, CPUIdlePercent: 75},
+		LoadSample:   &LoadSample{LoadOne: 1},
+		MemorySample: &MemorySample{MemoryTotal: 4096, MemoryFree: 1024, MemoryUsed: 3072},
+		HostSample:   &HostSample{Uptime: 123},
+		DiskSample:   &DiskSample{TotalBytes: 8192, capacityAvailable: true},
+		HostID:       "native-freebsd",
+	}
+	event.Type("SystemSample")
+	data, err := json.Marshal(event)
+	require.NoError(t, err)
+	var attributes map[string]interface{}
+	require.NoError(t, json.Unmarshal(data, &attributes))
+	assert.Equal(t, "SystemSample", attributes["eventType"])
+	assert.Equal(t, "native-freebsd", attributes["host.id"])
+	assert.Equal(t, float64(25), attributes["cpuPercent"])
+	assert.Equal(t, float64(1), attributes["loadAverageOneMinute"])
+	assert.Equal(t, float64(4096), attributes["memoryTotalBytes"])
+	assert.Equal(t, float64(8192), attributes["diskTotalBytes"])
+	assert.Equal(t, float64(123), attributes["uptime"])
+	for _, name := range []string{
+		"cpuIOWaitPercent", "cpuStealPercent", "memoryCachedBytes", "memorySlabBytes", "memorySharedBytes",
+		"diskReadUtilizationPercent", "diskWriteUtilizationPercent", "diskUtilizationPercent",
+		"diskReadsPerSecond", "diskWritesPerSecond",
+	} {
+		assert.NotContains(t, attributes, name)
+	}
+}
+
+func TestFreeBSDSystemSampleDistinguishesBaselineFromMeasuredIdle(t *testing.T) {
+	event := &SystemSample{CPUSample: defaultCPUSample, DiskSample: &DiskSample{}}
+	data, err := json.Marshal(event)
+	require.NoError(t, err)
+	var attributes map[string]interface{}
+	require.NoError(t, json.Unmarshal(data, &attributes))
+	assert.NotContains(t, attributes, "cpuPercent")
+	assert.NotContains(t, attributes, "diskTotalBytes")
+	assert.NotContains(t, attributes, "diskReadsPerSecond")
+
+	event.DiskSample.ioAvailable = true
+	data, err = json.Marshal(event)
+	require.NoError(t, err)
+	require.NoError(t, json.Unmarshal(data, &attributes))
+	assert.Equal(t, float64(0), attributes["diskReadsPerSecond"])
+	assert.Equal(t, float64(0), attributes["diskUtilizationPercent"])
+}
+
+func TestFreeBSDSystemSampleTruncationPreservesAvailableMetrics(t *testing.T) {
+	event := &SystemSample{
+		HostID: strings.Repeat("h", 65),
+		DiskSample: &DiskSample{
+			TotalBytes:        8192,
+			ReadsPerSec:       2,
+			capacityAvailable: true,
+			ioAvailable:       true,
+		},
+	}
+	limited, truncated := metric.TruncateLength(event, 64)
+	require.True(t, truncated)
+	data, err := json.Marshal(limited)
+	require.NoError(t, err)
+	var attributes map[string]interface{}
+	require.NoError(t, json.Unmarshal(data, &attributes))
+	assert.Equal(t, strings.Repeat("h", 64), attributes["host.id"])
+	assert.Equal(t, float64(8192), attributes["diskTotalBytes"])
+	assert.Equal(t, float64(2), attributes["diskReadsPerSecond"])
+	assert.Equal(t, strings.Repeat("h", 65), event.HostID)
+}
