+	assert.Equal(t, Result{Records: []Record{record}}, got)
+}
+
+func TestDecodeSoftflowdRecordSequences(t *testing.T) {
+	for _, initial := range []uint32{2, math.MaxUint32 - 1} {
+		t.Run(time.Duration(initial).String(), func(t *testing.T) {
+			decoder := NewDecoder()
+			makePacket := func(sequence uint32, count int, templateID uint16, templates bool) []byte {
+				var sets [][]byte
+				if templates {
+					sets = append(sets, testSet(0, testTemplate(1024, ipv4Fields)))
+				}
+				if count > 0 {
+					var body []byte
+					for range count {
+						body = append(body, sampleIPv4Data(1234, 7)...)
+					}
+					sets = append(sets, testSet(templateID, body))
+				}
+				packet := testPacket(sequence, 10000, 0, sets...)
+				binary.BigEndian.PutUint16(packet[2:4], uint16(len(packet)))
+				return packet
+			}
+			first := makePacket(initial, 2, 1024, true)
+			got, err := decoder.Decode(testExporter, first, testNow)
+			require.NoError(t, err)
+			assert.Equal(t, Result{Records: []Record{sampleIPv4Record(1234, 7), sampleIPv4Record(1234, 7)}}, got)
+			got, err = decoder.Decode(testExporter, makePacket(initial+3, 3, 1024, false), testNow)
+			require.NoError(t, err)
+			assert.Equal(t, Result{Records: []Record{
+				sampleIPv4Record(1234, 7), sampleIPv4Record(1234, 7), sampleIPv4Record(1234, 7),
+			}}, got)
+			got, err = decoder.Decode(testExporter, makePacket(initial+8, 2, 1024, false), testNow)
+			require.NoError(t, err)
+			assert.Equal(t, Result{SequenceGaps: 3,
+				Records: []Record{sampleIPv4Record(1234, 7), sampleIPv4Record(1234, 7)}}, got)
+			got, err = decoder.Decode(testExporter, makePacket(initial+18, 1, 4096, false), testNow)
+			require.NoError(t, err)
+			assert.Equal(t, Result{UnknownTemplates: 1}, got)
+			got, err = decoder.Decode(testExporter, makePacket(initial+19, 1, 1024, false), testNow)
+			require.NoError(t, err)
+			assert.Equal(t, Result{Records: []Record{sampleIPv4Record(1234, 7)}}, got)
+			got, err = decoder.Decode(testExporter, makePacket(initial+19, 0, 1024, true), testNow)
+			require.NoError(t, err)
+			assert.Equal(t, Result{}, got, "template-only refresh reuses cumulative data sequence")
+			got, err = decoder.Decode(testExporter, first, testNow)
+			require.NoError(t, err)
+			assert.Equal(t, Result{Duplicate: true}, got)
+		})
+	}
+}
+
+func TestDecodeReplayHistoryRemainsBounded(t *testing.T) {
+	decoder := NewDecoder()
+	original := testPacket(100, 10000, 0, testSet(0, testTemplate(1024, ipv4Fields)),
+		testSet(1024, sampleIPv4Data(100, 1)))
+	_, err := decoder.Decode(testExporter, original, testNow)
+	require.NoError(t, err)
+	for i := range sequenceWindow + 1 {
+		got, err := decoder.Decode(testExporter, testPacket(uint32(101+i), 10000, 0,
+			testSet(1024, sampleIPv4Data(uint64(1000+i), 10))), testNow)
+		require.NoError(t, err)
+		assert.Equal(t, Result{Records: []Record{sampleIPv4Record(uint64(1000+i), 10)}}, got)
+	}
+	state := decoder.exporters[exporterKey{address: testExporter}]
+	assert.Equal(t, sequenceWindow, state.recentCount)
+	before := snapshotDecoder(decoder)
+	got, err := decoder.Decode(testExporter, original, testNow)
+	require.NoError(t, err)
+	assert.Equal(t, Result{Duplicate: true}, got,
+		"old packets must stay suppressed after their fingerprints leave the ring")
+	assert.Equal(t, before, decoder)
+}
diff --git a/internal/netflow/template.go b/internal/netflow/template.go
new file mode 100644
index 0000000000000000000000000000000000000000..861915a8c44b84047c4634c8d7d1c29a2e2feabc
--- /dev/null
+++ b/internal/netflow/template.go
@@ -0,0 +1,218 @@
+// Copyright 2020 New Relic Corporation. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package netflow
+
+import (
+	"encoding/binary"
+	"errors"
+	"net/netip"
+	"slices"
+	"time"
+)
+
+type fieldLocation struct {
+	offset, length int
+}
+
+type flowTemplate struct {
+	source, destination, bytes, packets fieldLocation
+	size                                int
+	options, accounting                 bool
+	expires                             time.Time
+}
+
+func (tx *transaction) parseTemplates(body []byte, options bool) error {
+	if len(body) == 0 {
+		return errors.New("empty template set")
+	}
+	parsed := false
+	for len(body) != 0 {
+		if parsed && len(body) <= 3 && zeroPadding(body) {
+			return nil
+		}
+		headerLength := 4
+		if options {
+			headerLength = 6
+		}
+		if len(body) < headerLength {
+			return errors.New("truncated template header")
+		}
+		id := binary.BigEndian.Uint16(body)
+		count := int(binary.BigEndian.Uint16(body[2:4]))
+		if options {
+			scopeLength := count
+			optionLength := int(binary.BigEndian.Uint16(body[4:6]))
+			if scopeLength == 0 || scopeLength%4 != 0 || optionLength%4 != 0 {
+				return errors.New("invalid options template field lengths")
+			}
+			count = (scopeLength + optionLength) / 4
+		}
+		if id < 256 || count == 0 || count > maxFields {
+			return errors.New("invalid template ID or field count")
+		}
+		length := headerLength + count*4
+		if length > len(body) {
+			return errors.New("truncated template fields")
+		}
+		template, err := compileTemplate(body[headerLength:length], options)
+		if err != nil {
+			return err
+		}
+		template.expires = tx.now.Add(templateLifetime)
+		if err := tx.storeTemplate(id, template); err != nil {
+			return err
+		}
+		body = body[length:]
+		parsed = true
+	}
+	return nil
+}
+
+func compileTemplate(fields []byte, options bool) (flowTemplate, error) {
+	template := flowTemplate{options: options}
+	for len(fields) != 0 {
+		kind := binary.BigEndian.Uint16(fields)
+		length := int(binary.BigEndian.Uint16(fields[2:4]))
+		if length == 0 || length > maxDatagramSize-headerSize-4-template.size {
+			return flowTemplate{}, errors.New("invalid field or record length")
+		}
+		if !options {
+			var location *fieldLocation
+			switch kind {
+			case 1:
+				location = &template.bytes
+			case 2:
+				location = &template.packets
+			case 8, 27:
+				location = &template.source
+			case 12, 28:
+				location = &template.destination
+			}
+			if location != nil {
+				if location.length != 0 || !validFieldLength(kind, length) {
+					return flowTemplate{}, errors.New("duplicate field or invalid accounting field width")
+				}
+				*location = fieldLocation{offset: template.size, length: length}
+			}
+		}
+		template.size += length
+		fields = fields[4:]
+	}
+	if template.source.length != 0 && template.destination.length != 0 &&
+		template.source.length != template.destination.length {
+		return flowTemplate{}, errors.New("mixed source and destination address families")
+	}
+	template.accounting = !options && template.source.length != 0 && template.destination.length != 0 &&
+		template.bytes.length != 0 && template.packets.length != 0
+	return template, nil
+}
+
+func validFieldLength(kind uint16, length int) bool {
+	switch kind {
+	case 1, 2:
+		return length == 1 || length == 2 || length == 4 || length == 8
+	case 8, 12:
+		return length == 4
+	case 27, 28:
+		return length == 16
+	}
+	return false
+}
+
+func (tx *transaction) storeTemplate(id uint16, template flowTemplate) error {
+	if tx.updates == nil {
+		tx.updates = make(map[uint16]flowTemplate)
+	}
+	if _, exists := tx.lookupTemplate(id); !exists {
+		count := len(tx.updates)
+		if tx.base != nil {
+			for cachedID, cached := range tx.base.templates {
+				if _, replaced := tx.updates[cachedID]; !replaced && tx.now.Before(cached.expires) {
+					count++
+				}
+			}
+		}
+		if count >= maxTemplates {
+			return errors.New("template limit exceeded")
+		}
+	}
+	tx.updates[id] = template
+	return nil
+}
+
+func (tx *transaction) lookupTemplate(id uint16) (flowTemplate, bool) {
+	if template, exists := tx.updates[id]; exists {
+		return template, true
+	}
+	if tx.base != nil {
+		if template, exists := tx.base.templates[id]; exists && tx.now.Before(template.expires) {
+			return template, true
+		}
+	}
+	return flowTemplate{}, false
+}
+
+func (tx *transaction) parseData(id uint16, body []byte) error {
+	if len(body) == 0 {
+		return errors.New("empty data set")
+	}
+	template, exists := tx.lookupTemplate(id)
+	if !exists {
+		tx.result.UnknownTemplates++
+		return nil
+	}
+	count := len(body) / template.size
+	padding := body[count*template.size:]
+	if count == 0 || len(padding) > 3 || !zeroPadding(padding) {
+		return errors.New("truncated data record or invalid padding")
+	}
+	if !template.options {
+		tx.dataRecords += uint32(count)
+	}
+	if !template.accounting {
+		return nil
+	}
+	tx.result.Records = slices.Grow(tx.result.Records, count)
+	for i := range count {
+		data := body[i*template.size : (i+1)*template.size]
+		tx.result.Records = append(tx.result.Records, Record{
+			Source:      readAddress(data, template.source),
+			Destination: readAddress(data, template.destination),
+			Bytes:       readCounter(data, template.bytes),
+			Packets:     readCounter(data, template.packets),
+		})
+	}
+	return nil
+}
+
+func readAddress(data []byte, field fieldLocation) netip.Addr {
+	data = data[field.offset : field.offset+field.length]
+	if field.length == 4 {
+		return netip.AddrFrom4([4]byte(data))
+	}
+	return netip.AddrFrom16([16]byte(data)).Unmap()
+}
+
+func readCounter(data []byte, field fieldLocation) uint64 {
+	data = data[field.offset : field.offset+field.length]
+	switch field.length {
+	case 1:
+		return uint64(data[0])
+	case 2:
+		return uint64(binary.BigEndian.Uint16(data))
+	case 4:
+		return uint64(binary.BigEndian.Uint32(data))
+	default:
+		return binary.BigEndian.Uint64(data)
+	}
+}
+
+func zeroPadding(data []byte) bool {
+	for _, value := range data {
+		if value != 0 {
+			return false
+		}
+	}
+	return true
+}
