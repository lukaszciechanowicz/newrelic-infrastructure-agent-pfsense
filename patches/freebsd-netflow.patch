+// Copyright 2020 New Relic Corporation. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package netflow
+
+import (
+	"encoding/binary"
+	"net/netip"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestDecodeMalformedDatagramsAreAtomic(t *testing.T) {
+	manyFields := make([]testField, maxFields+1)
+	for i := range manyFields {
+		manyFields[i] = testField{900, 1}
+	}
+	templateSet := func(fields ...testField) []byte {
+		return testSet(0, testTemplate(1024, fields))
+	}
+	packet := func(sets ...[]byte) []byte { return testPacket(11, 11000, 0, sets...) }
+	version5 := packet(testSet(1024, sampleIPv4Data(1000, 10)))
+	binary.BigEndian.PutUint16(version5, 5)
+	version10 := append([]byte(nil), version5...)
+	binary.BigEndian.PutUint16(version10, 10)
+	oversized := make([]byte, maxDatagramSize+1)
+	copy(oversized, packet(testSet(1024, sampleIPv4Data(1000, 10))))
+	cases := []struct {
+		name   string
+		packet []byte
+	}{
+		{"empty datagram", nil},
+		{"short header", make([]byte, headerSize-1)},
+		{"header without FlowSets", packet()},
+		{"NetFlow v5", version5},
+		{"IPFIX", version10},
+		{"oversized datagram", oversized},
+		{"FlowSet header one byte", append(packet(), 0)},
+		{"FlowSet header three bytes", append(packet(), 0, 0, 0)},
+		{"FlowSet length zero", packet([]byte{4, 0, 0, 0})},
+		{"FlowSet length below header", packet([]byte{4, 0, 0, 3})},
+		{"FlowSet length exceeds datagram", packet([]byte{4, 0, 0, 8, 1})},
+		{"reserved FlowSet truncated", packet([]byte{0, 2, 0, 8, 1})},
+		{"empty template set", packet(testSet(0))},
+		{"template padding without template", packet(testSet(0, []byte{0, 0, 0}))},
+		{"truncated template header", packet(testSet(0, []byte{4, 0}))},
+		{"reserved template ID", packet(testSet(0, testTemplate(255, ipv4Fields)))},
+		{"zero template fields", packet(testSet(0, testTemplate(1024, nil)))},
+		{"too many fields", packet(testSet(0, testTemplate(1024, manyFields)))},
+		{"truncated template fields", packet(testSet(0, []byte{4, 0, 0, 2, 0, 1, 0, 4}))},
+		{"zero unknown field length", packet(templateSet(testField{900, 0}))},
+		{"three-byte byte counter", packet(templateSet(testField{1, 3}))},
+		{"six-byte packet counter", packet(templateSet(testField{2, 6}))},
+		{"sixteen-byte byte counter", packet(templateSet(testField{1, 16}))},
+		{"IPv4 source width", packet(templateSet(testField{8, 16}))},
+		{"IPv4 destination width", packet(templateSet(testField{12, 1}))},
+		{"IPv6 source width", packet(templateSet(testField{27, 4}))},
+		{"IPv6 destination width", packet(templateSet(testField{28, 8}))},
+		{"duplicate byte counter", packet(templateSet(testField{1, 4}, testField{1, 8}))},
+		{"duplicate packet counter", packet(templateSet(testField{2, 4}, testField{2, 4}))},
+		{"duplicate source address", packet(templateSet(testField{8, 4}, testField{8, 4}))},
+		{"ambiguous source families", packet(templateSet(testField{8, 4}, testField{27, 16}))},
+		{"mixed endpoint families", packet(templateSet(testField{8, 4}, testField{28, 16}))},
+		{"record length exceeds datagram", packet(templateSet(
+			testField{900, maxDatagramSize - headerSize - 4}, testField{901, 1}))},
+		{"template nonzero padding", packet(testSet(0, testTemplate(1024, ipv4Fields), []byte{1}))},
+		{"template padding too long", packet(testSet(0, testTemplate(1024, ipv4Fields), make([]byte, 4)))},
+		{"empty options template", packet(testSet(1))},
+		{"truncated options header", packet(testSet(1, []byte{1, 0, 0, 4, 0}))},
+		{"options without scope", packet(testSet(1, testOptions(256, nil, []testField{{34, 4}})))},
+		{"options scope definition length", packet(testSet(1, []byte{1, 0, 0, 3, 0, 4}))},
+		{"options field definition length", packet(testSet(1, []byte{1, 0, 0, 4, 0, 3}))},
+		{"truncated options definitions", packet(testSet(1, []byte{1, 0, 0, 4, 0, 4, 0, 2, 0, 4}))},
+		{"too many options fields", packet(testSet(1, testOptions(256, manyFields[:1], manyFields[1:])))},
+		{"zero options data field width", packet(testSet(1,
+			testOptions(256, []testField{{2, 4}}, []testField{{34, 0}})))},
+		{"options nonzero padding", packet(testSet(1,
+			testOptions(256, []testField{{2, 4}}, []testField{{34, 4}}), []byte{1}))},
+		{"empty known data set", packet(testSet(1024))},
+		{"empty unknown data set", packet(testSet(2048))},
+		{"short data record", packet(testSet(1024, make([]byte, 15)))},
+		{"data nonzero padding", packet(testSet(1024, sampleIPv4Data(1000, 10), []byte{1}))},
+		{"data padding too long", packet(testSet(1024, sampleIPv4Data(1000, 10), make([]byte, 4)))},
+		{"truncated second record", packet(testSet(1024, sampleIPv4Data(1000, 10), make([]byte, 8)))},
+		{"truncated options data", packet(testSet(1,
+			testOptions(256, []testField{{2, 4}}, []testField{{34, 4}, {35, 1}})),
+			testSet(256, make([]byte, 8)))},
+		{"valid records followed by bad framing", packet(testSet(1024, sampleIPv4Data(1000, 10)),
+			[]byte{0, 0, 0})},
+		{"unknown templates followed by malformed set", packet(testSet(2048, []byte{1}),
+			[]byte{0, 0, 0})},
+		{"template change followed by malformed set", packet(templateSet(
+			testField{8, 4}, testField{12, 4}, testField{1, 8}, testField{2, 8}), []byte{0})},
+		{"reboot followed by malformed set", testPacket(1, 1, 0, []byte{0, 0, 0})},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			decoder := NewDecoder()
+			_, err := decoder.Decode(testExporter, testPacket(10, 10000, 0,
+				testSet(0, testTemplate(1024, ipv4Fields)), testSet(1024, sampleIPv4Data(100, 1))), testNow)
+			require.NoError(t, err)
+			before := snapshotDecoder(decoder)
+			got, err := decoder.Decode(testExporter, tc.packet, testNow.Add(1))
+			require.Error(t, err)
+			assert.Equal(t, Result{}, got)
+			assert.Equal(t, before, decoder, "malformed datagram changed state")
+			got, err = decoder.Decode(testExporter, packet(testSet(1024, sampleIPv4Data(1234, 7))), testNow.Add(2))
+			require.NoError(t, err)
+			assert.Equal(t, Result{Records: []Record{sampleIPv4Record(1234, 7)}}, got)
+		})
+	}
+}
+
+func TestDecodeTruncatedDatagramAtEveryByte(t *testing.T) {
+	decoder := NewDecoder()
+	_, err := decoder.Decode(testExporter, testPacket(1, 10000, 0,
+		testSet(0, testTemplate(1024, ipv4Fields))), testNow)
+	require.NoError(t, err)
+	packet := testPacket(2, 10001, 0, testSet(1024, sampleIPv4Data(987654321, 1234)))
+	before := snapshotDecoder(decoder)
+	for length := range len(packet) {
+		got, err := decoder.Decode(testExporter, packet[:length], testNow)
+		require.Error(t, err, "prefix length %d", length)
+		assert.Equal(t, Result{}, got)
+		assert.Equal(t, before, decoder)
+	}
+	got, err := decoder.Decode(testExporter, packet, testNow)
+	require.NoError(t, err)
+	assert.Equal(t, Result{Records: []Record{sampleIPv4Record(987654321, 1234)}}, got)
+}
+
+func TestDecodeInvalidExporterIsAtomic(t *testing.T) {
+	var decoder Decoder
+	got, err := decoder.Decode(netip.AddrPort{}, testPacket(1, 1, 0, testSet(2048, []byte{1})), testNow)
+	require.Error(t, err)
+	assert.Equal(t, Result{}, got)
+	assert.Nil(t, decoder.exporters)
+}
