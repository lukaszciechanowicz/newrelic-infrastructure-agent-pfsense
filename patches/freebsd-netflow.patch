index 0000000000000000000000000000000000000000..769a6d0273ec46c308d3640877decd46cd959c03
--- /dev/null
+++ b/pkg/metrics/storage/storage_sampler_freebsd.go
@@ -0,0 +1,191 @@
+// Copyright 2026 New Relic Corporation. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package storage
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/newrelic/infrastructure-agent/pkg/config"
+	"github.com/newrelic/infrastructure-agent/pkg/metrics/acquire"
+	"github.com/shirou/gopsutil/v3/disk"
+	"golang.org/x/sys/unix"
+)
+
+var SupportedFileSystems = map[string]bool{
+	"ufs":     true,
+	"zfs":     true,
+	"msdosfs": true,
+	"exfat":   true,
+	"ext2fs":  true,
+	"cd9660":  true,
+}
+
+type Sample struct {
+	BaseSample
+	InodesUsed        *uint64  `json:"inodesUsed,omitempty"`
+	InodesFree        *uint64  `json:"inodesFree,omitempty"`
+	InodesTotal       *uint64  `json:"inodesTotal,omitempty"`
+	InodesUsedPercent *float64 `json:"inodesUsedPercent,omitempty"`
+}
+
+type FreeBSDIOCountersStat struct{ disk.IOCountersStat }
+
+func (FreeBSDIOCountersStat) Source() string { return "devstat" }
+
+type FreeBSDStorageSampleWrapper struct{ partitions PartitionsCache }
+
+func NewStorageSampleWrapper(cfg *config.Config) SampleWrapper {
+	ttl := time.Minute
+	if cfg != nil {
+		if configured, err := time.ParseDuration(cfg.PartitionsTTL); err == nil {
+			ttl = configured
+		}
+	}
+	return &FreeBSDStorageSampleWrapper{partitions: PartitionsCache{
+		ttl:            ttl,
+		partitionsFunc: fetchPartitions,
+	}}
+}
+
+func (s *FreeBSDStorageSampleWrapper) Partitions() ([]PartitionStat, error) {
+	return s.partitions.Get()
+}
+func (*FreeBSDStorageSampleWrapper) Usage(path string) (*disk.UsageStat, error) {
+	return disk.Usage(path)
+}
+
+func fetchPartitions(_ bool) ([]PartitionStat, error) {
+	partitions, err := disk.Partitions(true)
+	if err != nil {
+		return nil, err
+	}
+	result := make([]PartitionStat, 0, len(partitions))
+	for _, partition := range partitions {
+		if !SupportedFileSystems[partition.Fstype] {
+			continue
+		}
+		result = append(result, PartitionStat{
+			Device:     partition.Device,
+			Mountpoint: partition.Mountpoint,
+			Fstype:     partition.Fstype,
+			Opts:       strings.Join(partition.Opts, ","),
+		})
+	}
+	return result, nil
+}
+
+func (*FreeBSDStorageSampleWrapper) IOCounters() (map[string]IOCountersStat, error) {
+	return freebsdDiskIOCounters()
+}
+
+func (*FreeBSDStorageSampleWrapper) CalculateSampleValues(counter, previous IOCountersStat, elapsedMs int64) *Sample {
+	current, ok := counter.(FreeBSDIOCountersStat)
+	last, lastOK := previous.(FreeBSDIOCountersStat)
+	result := &Sample{}
+	if !ok || !lastOK || elapsedMs <= 0 {
+		return result
+	}
+	// A reset/hot-plug invalidates the interval rather than creating unsigned
+	// wraparound or reporting an unsupported measurement as zero.
+	if current.ReadCount < last.ReadCount || current.WriteCount < last.WriteCount ||
+		current.ReadBytes < last.ReadBytes || current.WriteBytes < last.WriteBytes ||
+		current.ReadTime < last.ReadTime || current.WriteTime < last.WriteTime || current.IoTime < last.IoTime {
+		return result
+	}
+	seconds := float64(elapsedMs) / 1000
+	reads := acquire.CalculateSafeDelta(current.ReadCount, last.ReadCount, seconds)
+	writes := acquire.CalculateSafeDelta(current.WriteCount, last.WriteCount, seconds)
+	readBytes := acquire.CalculateSafeDelta(current.ReadBytes, last.ReadBytes, seconds)
+	writeBytes := acquire.CalculateSafeDelta(current.WriteBytes, last.WriteBytes, seconds)
+	result.ReadsPerSec, result.WritesPerSec = &reads, &writes
+	result.ReadBytesPerSec, result.WriteBytesPerSec = &readBytes, &writeBytes
+	result.ReadCountDelta = current.ReadCount - last.ReadCount
+	result.WriteCountDelta = current.WriteCount - last.WriteCount
+	result.IOTimeDelta = current.IoTime - last.IoTime
+	result.ReadTimeDelta = current.ReadTime - last.ReadTime
+	result.WriteTimeDelta = current.WriteTime - last.WriteTime
+	utilization := float64(result.IOTimeDelta) / float64(elapsedMs) * 100
+	if utilization > 100 {
+		utilization = 100
+	}
+	result.TotalUtilizationPercent = &utilization
+	// devstat records operation duration, which can overlap. Do not represent
+	// its read/write split as measured device busy percentages.
+	return result
+}
+
+func populateSampleOS(_, _ *Sample) {}
+
+func populateUsageOS(usage *disk.UsageStat, sample *Sample) {
+	if usage.InodesTotal == 0 {
+		return
+	}
+	sample.InodesUsed = &usage.InodesUsed
+	sample.InodesFree = &usage.InodesFree
+	sample.InodesTotal = &usage.InodesTotal
+	sample.InodesUsedPercent = &usage.InodesUsedPercent
+}
+
+// CalculateDeviceMapping follows GEOM topology rather than guessing disk names
+// from partition/label strings. A whole-disk counter is attributed to a mounted
+// device only when exactly one active provider uses that disk.
+func CalculateDeviceMapping(active map[string]bool, _ bool) map[string]string {
+	topology, err := unix.Sysctl("kern.geom.conftxt")
+	if err != nil {
+		sslog.WithError(err).Warn("Cannot map GEOM providers to mounted devices.")
+		return nil
+	}
+	mapping, err := deviceMappingFromGEOM(topology, active)
+	if err != nil {
+		sslog.WithError(err).Warn("Cannot parse GEOM provider topology.")
+		return nil
+	}
+	return mapping
+}
+
+func deviceMappingFromGEOM(topology string, active map[string]bool) (map[string]string, error) {
+	ancestors := make(map[string][]string)
+	var stack []string
+	for _, line := range strings.Split(strings.TrimRight(topology, "\x00\n"), "\n") {
+		fields := strings.Fields(line)
+		if len(fields) == 0 {
+			continue
+		}
+		if len(fields) < 3 {
+			return nil, fmt.Errorf("invalid GEOM provider line %q", line)
+		}
+		depth, err := strconv.Atoi(fields[0])
+		if err != nil || depth < 0 || depth > len(stack) {
+			return nil, fmt.Errorf("invalid GEOM provider depth in %q", line)
+		}
+		stack = append(stack[:depth], fields[2])
+		ancestors[fields[2]] = append([]string(nil), stack...)
+	}
+	mapping := make(map[string]string)
+	ambiguous := make(map[string]bool)
+	for device := range active {
+		if !strings.HasPrefix(device, "/dev/") {
+			continue
+		}
+		provider := strings.TrimPrefix(device, "/dev/")
+		chain := ancestors[provider]
+		if len(chain) == 0 {
+			chain = []string{provider}
+		}
+		for _, ancestor := range chain {
+			if previous, found := mapping[ancestor]; found && previous != device {
+				ambiguous[ancestor] = true
+			} else {
+				mapping[ancestor] = device
+			}
+		}
+	}
+	for provider := range ambiguous {
+		delete(mapping, provider)
+	}
+	return mapping, nil
+}
