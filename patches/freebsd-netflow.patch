@@ -0,0 +1,34 @@
+#!/bin/sh
+# Copyright 2026 New Relic Corporation. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+
+# PROVIDE: newrelic_infra
+# REQUIRE: NETWORKING SERVERS
+# KEYWORD: shutdown
+
+. /etc/rc.subr
+
+name="newrelic_infra"
+rcvar="newrelic_infra_enable"
+
+load_rc_config "${name}"
+
+: "${newrelic_infra_enable:=NO}"
+: "${newrelic_infra_config:=/usr/local/etc/newrelic-infra.yml}"
+
+pidfile="/var/run/newrelic-infra/service.pid"
+command="/usr/sbin/daemon"
+command_args="-c -f -r -R 5 -P ${pidfile} -S -T newrelic-infra /usr/local/bin/newrelic-infra -config ${newrelic_infra_config}"
+required_files="${newrelic_infra_config}"
+start_precmd="newrelic_infra_prestart"
+
+newrelic_infra_prestart()
+{
+	if [ ! -x /usr/local/bin/newrelic-infra ]; then
+		warn "/usr/local/bin/newrelic-infra is not executable"
+		return 1
+	fi
+	install -d -m 0750 /var/db/newrelic-infra /var/log/newrelic-infra /var/run/newrelic-infra
+}
+
+run_rc_command "$1"
