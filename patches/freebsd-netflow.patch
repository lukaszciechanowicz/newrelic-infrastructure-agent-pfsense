+	got, err = decoder.Decode(testExporter, testPacket(11, 11000, 0,
+		testSet(0, testTemplate(1024, ipv4Fields)), testSet(1024, sampleIPv4Data(1234, 7))),
+		testNow.Add(2*time.Second))
+	require.NoError(t, err)
+	assert.Equal(t, Result{Records: []Record{sampleIPv4Record(1234, 7)}}, got)
+	got, err = decoder.Decode(testExporter, testPacket(13, 13000, 0, testSet(1024, data)),
+		testNow.Add(3*time.Second))
+	require.NoError(t, err)
+	assert.Equal(t, Result{Records: []Record{record}}, got)
+}
+
+func TestDecodeRebootReplacesTemplatesAtomically(t *testing.T) {
+	decoder := NewDecoder()
+	_, err := decoder.Decode(testExporter, testPacket(100, 10000, 0,
+		testSet(0, testTemplate(1024, ipv4Fields))), testNow)
+	require.NoError(t, err)
+	fields := []testField{{27, 16}, {28, 16}, {1, 8}, {2, 8}}
+	record := Record{Source: netip.MustParseAddr("2001:db8::10"),
+		Destination: netip.MustParseAddr("2001:db8::20"), Bytes: 1 << 40, Packets: 300}
+	got, err := decoder.Decode(testExporter, testPacket(1, 1, 0,
+		testSet(0, testTemplate(1024, fields)),
+		testSet(1024, testData(fields, record.Source, record.Destination, record.Bytes, record.Packets))),
+		testNow.Add(time.Second))
