@@ -0,0 +1,412 @@
+// Copyright 2026 New Relic Corporation. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package netflow
+
+import (
+	"context"
+	"encoding/binary"
+	"errors"
+	"net"
+	"net/netip"
+	"reflect"
+	"testing"
+	"time"
+
+	flow "github.com/newrelic/infrastructure-agent/internal/netflow"
+	"github.com/newrelic/infrastructure-agent/pkg/config"
+	"github.com/newrelic/infrastructure-agent/pkg/sample"
+)
+
+func testSampler(maxIPs int, cidrs ...string) (*Sampler, *time.Time) {
+	now := time.Unix(1700000000, 0)
+	s := &Sampler{
+		enabled:          true,
+		interval:         defaultSampleInterval,
+		maxIPs:           maxIPs,
+		observationPoint: "test-observation",
+		windowStarted:    now,
+		now:              func() time.Time { return now },
+	}
+	for _, cidr := range cidrs {
+		s.trackedCIDRs = append(s.trackedCIDRs, netip.MustParsePrefix(cidr))
+	}
+	return s, &now
+}
+
+func record(source, destination string, bytes, packets uint64) flow.Record {
+	return flow.Record{
+		Source:      netip.MustParseAddr(source),
+		Destination: netip.MustParseAddr(destination),
+		Bytes:       bytes,
+		Packets:     packets,
+	}
+}
+
+func drain(t *testing.T, s *Sampler) (map[string]*IPTrafficSample, *FlowCollectorSample) {
+	t.Helper()
+	batch, err := s.Sample()
+	if err != nil {
+		t.Fatal(err)
+	}
+	ips := make(map[string]*IPTrafficSample)
+	var collector *FlowCollectorSample
+	for _, event := range batch {
+		switch event := event.(type) {
+		case *IPTrafficSample:
+			if event.EventType != "PfIpTrafficSample" {
+				t.Fatalf("IP event type = %q", event.EventType)
+			}
+			if _, exists := ips[event.IP]; exists {
+				t.Fatalf("duplicate event for IP %q", event.IP)
+			}
+			ips[event.IP] = event
+		case *FlowCollectorSample:
+			if collector != nil || event.EventType != "PfFlowCollectorSample" {
+				t.Fatalf("unexpected collector event: %+v", event)
+			}
+			collector = event
+		default:
+			t.Fatalf("unexpected sample type %T", event)
+		}
+	}
+	if collector == nil {
+		t.Fatal("missing collector event")
+	}
+	return ips, collector
+}
+
+func assertTraffic(t *testing.T, event *IPTrafficSample, sent, received, packetsSent, packetsReceived, records uint64) {
+	t.Helper()
+	if event == nil {
+		t.Fatal("missing IP event")
+	}
+	got := [...]uint64{event.BytesSent, event.BytesReceived, event.PacketsSent, event.PacketsReceived, event.FlowRecords}
+	want := [...]uint64{sent, received, packetsSent, packetsReceived, records}
+	if got != want {
+		t.Fatalf("IP %s counters [sent received packetsSent packetsReceived records] = %v, want %v", event.IP, got, want)
+	}
+}
+
+func assertDiagnostics(t *testing.T, event *FlowCollectorSample, datagrams, records, unknown, malformed, gaps, duplicate, dropped uint64) {
+	t.Helper()
+	got := [...]uint64{
+		event.DatagramsReceived, event.RecordsDecoded, event.UnknownTemplates,
+		event.MalformedDatagrams, event.SequenceGaps, event.DuplicateDatagrams, event.DroppedIPs,
+	}
+	want := [...]uint64{datagrams, records, unknown, malformed, gaps, duplicate, dropped}
+	if got != want {
+		t.Fatalf("collector [datagrams records unknown malformed gaps duplicate dropped] = %v, want %v", got, want)
+	}
+}
+
+func TestDirectionsCanonicalAddressesAndDeltaWindows(t *testing.T) {
+	s, now := testSampler(8)
+	s.collect(flow.Result{Records: []flow.Record{
+		record("192.0.2.10", "198.51.100.20", 100, 2),
+		record("198.51.100.20", "192.0.2.10", 60, 1),
+		record("192.0.2.10", "192.0.2.10", 5, 1),
+		record("2001:db8::1", "192.0.2.10", 25, 4),
+		record("::ffff:192.0.2.10", "2001:db8:0:0::1", 10, 1),
+	}}, nil)
+	*now = now.Add(15 * time.Second)
+	ips, collector := drain(t, s)
+	if len(ips) != 3 {
+		t.Fatalf("IP count = %d, want 3", len(ips))
+	}
+	assertTraffic(t, ips["192.0.2.10"], 115, 90, 4, 6, 5)
+	assertTraffic(t, ips["198.51.100.20"], 60, 100, 1, 2, 2)
+	assertTraffic(t, ips["2001:db8::1"], 25, 10, 4, 1, 2)
+	assertDiagnostics(t, collector, 1, 5, 0, 0, 0, 0, 0)
+	for _, event := range ips {
+		if event.IntervalMs != 15000 || event.ObservationPoint != "test-observation" {
+			t.Fatalf("unexpected IP window metadata: %+v", event)
+		}
+	}
+	if collector.IntervalMs != 15000 || collector.ObservationPoint != "test-observation" {
+		t.Fatalf("unexpected collector window metadata: %+v", collector)
+	}
+
+	s.collect(flow.Result{Records: []flow.Record{
+		record("198.51.100.20", "192.0.2.10", 7, 1),
+	}}, nil)
+	*now = now.Add(15 * time.Second)
+	ips, collector = drain(t, s)
+	if len(ips) != 2 {
+		t.Fatalf("second-window IP count = %d, want 2", len(ips))
+	}
+	assertTraffic(t, ips["192.0.2.10"], 0, 7, 0, 1, 1)
+	assertTraffic(t, ips["198.51.100.20"], 7, 0, 1, 0, 1)
+	assertDiagnostics(t, collector, 1, 1, 0, 0, 0, 0, 0)
+	// A later drain must not mutate already returned events.
+	if collector.IntervalMs != 15000 {
+		t.Fatalf("second interval = %d", collector.IntervalMs)
+	}
+	previous := ips["192.0.2.10"]
+	*now = now.Add(15 * time.Second)
+	ips, collector = drain(t, s)
+	if len(ips) != 0 {
+		t.Fatalf("idle window fabricated IP events: %+v", ips)
+	}
+	assertDiagnostics(t, collector, 0, 0, 0, 0, 0, 0, 0)
+	if collector.IntervalMs != 15000 {
+		t.Fatalf("idle interval = %d", collector.IntervalMs)
+	}
+	assertTraffic(t, previous, 0, 7, 0, 1, 1)
+}
+
+func TestTrackedCIDRsSelectEndpointsIndependently(t *testing.T) {
+	s, _ := testSampler(3, "192.0.2.0/24", "2001:db8:1::/48")
+	s.collect(flow.Result{Records: []flow.Record{
+		record("192.0.2.1", "198.51.100.1", 100, 2),
+		record("198.51.100.1", "192.0.2.1", 50, 1),
+		record("192.0.2.1", "192.0.2.2", 70, 3),
+		record("2001:db8:1::1", "2001:db8:2::1", 80, 4),
+		record("203.0.113.1", "198.51.100.1", 1000, 20),
+	}}, nil)
+	ips, collector := drain(t, s)
+	if len(ips) != 3 {
+		t.Fatalf("IP count = %d, want 3", len(ips))
+	}
+	assertTraffic(t, ips["192.0.2.1"], 170, 50, 5, 1, 3)
+	assertTraffic(t, ips["192.0.2.2"], 0, 70, 0, 3, 1)
+	assertTraffic(t, ips["2001:db8:1::1"], 80, 0, 4, 0, 1)
+	assertDiagnostics(t, collector, 1, 5, 0, 0, 0, 0, 0)
+}
+
+func TestCardinalityRetainsAdmittedIPsAndResetsOnDrain(t *testing.T) {
+	s, _ := testSampler(2)
+	s.collect(flow.Result{Records: []flow.Record{
+		record("192.0.2.1", "192.0.2.2", 100, 2),
+		record("192.0.2.3", "192.0.2.1", 25, 1),
+		record("192.0.2.3", "192.0.2.2", 30, 2),
+		record("192.0.2.3", "192.0.2.4", 40, 3),
+	}}, nil)
+	ips, collector := drain(t, s)
+	if len(ips) != 2 {
+		t.Fatalf("IP count exceeded limit: %d", len(ips))
+	}
+	assertTraffic(t, ips["192.0.2.1"], 100, 25, 2, 1, 2)
+	assertTraffic(t, ips["192.0.2.2"], 0, 130, 0, 4, 2)
+	assertDiagnostics(t, collector, 1, 4, 0, 0, 0, 0, 4)
+
+	s.collect(flow.Result{Records: []flow.Record{
+		record("192.0.2.3", "192.0.2.4", 40, 3),
+	}}, nil)
+	ips, collector = drain(t, s)
+	if len(ips) != 2 {
+		t.Fatalf("new-window IP count = %d, want 2", len(ips))
+	}
+	assertTraffic(t, ips["192.0.2.3"], 40, 0, 3, 0, 1)
+	assertTraffic(t, ips["192.0.2.4"], 0, 40, 0, 3, 1)
+	assertDiagnostics(t, collector, 1, 1, 0, 0, 0, 0, 0)
+}
+
+func TestDiagnosticDeltasAndRejectedDatagrams(t *testing.T) {
+	s, _ := testSampler(2)
+	records := []flow.Record{record("192.0.2.1", "192.0.2.2", 100, 1)}
+	// No partial records or diagnostics from a failed decode may be accounted.
+	s.collect(flow.Result{Records: records, UnknownTemplates: 99, SequenceGaps: 99}, errors.New("malformed"))
+	s.collect(flow.Result{UnknownTemplates: 2, SequenceGaps: 3}, nil)
+	s.collect(flow.Result{Duplicate: true, Records: records}, nil)
+	ips, collector := drain(t, s)
+	if len(ips) != 0 {
+		t.Fatalf("failed or duplicate datagram contributed traffic: %+v", ips)
+	}
+	assertDiagnostics(t, collector, 3, 0, 2, 1, 3, 1, 0)
+	_, collector = drain(t, s)
+	assertDiagnostics(t, collector, 0, 0, 0, 0, 0, 0, 0)
+}
+
+func TestConstructorDefaultsAndCanonicalCIDRs(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	s, err := New(ctx, config.NetFlowConfig{
+		Enabled:      true,
+		Listen:       "127.0.0.1:0",
+		TrackedCIDRs: []string{"::ffff:192.0.2.129/120", "2001:db8::abcd/64"},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if s.Disabled() || s.Interval() != 15*time.Second || s.maxIPs != 8192 || s.Name() != "NetFlowSampler" {
+		t.Fatalf("unexpected defaults: disabled=%t interval=%s maxIPs=%d name=%q", s.Disabled(), s.Interval(), s.maxIPs, s.Name())
+	}
+	want := []netip.Prefix{netip.MustParsePrefix("192.0.2.0/24"), netip.MustParsePrefix("2001:db8::/64")}
+	if !reflect.DeepEqual(s.trackedCIDRs, want) {
+		t.Fatalf("tracked prefixes = %v, want %v", s.trackedCIDRs, want)
+	}
+	s.collect(flow.Result{Records: []flow.Record{
+		record("::ffff:192.0.2.1", "2001:db8::1", 10, 1),
+	}}, nil)
+	ips, collector := drain(t, s)
+	assertTraffic(t, ips["192.0.2.1"], 10, 0, 1, 0, 1)
+	assertTraffic(t, ips["2001:db8::1"], 0, 10, 0, 1, 1)
+	assertDiagnostics(t, collector, 1, 1, 0, 0, 0, 0, 0)
+	// Cancellation before startup must release the listener as well.
+	address := s.listener.LocalAddr().String()
+	cancel()
+	if err := s.listener.SetReadDeadline(time.Now().Add(5 * time.Second)); err != nil && !errors.Is(err, net.ErrClosed) {
+		t.Fatal(err)
+	}
+	var packet [1]byte
+	if _, _, err := s.listener.ReadFromUDPAddrPort(packet[:]); !errors.Is(err, net.ErrClosed) {
+		t.Fatalf("listener before startup was not closed by cancellation: %v", err)
+	}
+	s.OnStartup()
+	waitForReceiver(t, s)
+	assertCanBind(t, address)
+}
+
+func TestConstructorValidationAndDisabledSampler(t *testing.T) {
+	for name, mutate := range map[string]func(*config.NetFlowConfig){
+		"negative interval": func(cfg *config.NetFlowConfig) { cfg.SampleInterval = -1 },
+		"negative capacity": func(cfg *config.NetFlowConfig) { cfg.MaxIPs = -1 },
+		"invalid prefix":    func(cfg *config.NetFlowConfig) { cfg.TrackedCIDRs = []string{"not-a-prefix"} },
+		"invalid listen":    func(cfg *config.NetFlowConfig) { cfg.Listen = "not-an-address" },
+	} {
+		t.Run(name, func(t *testing.T) {
+			cfg := config.NetFlowConfig{Enabled: true, Listen: "127.0.0.1:0"}
+			mutate(&cfg)
+			if _, err := New(context.Background(), cfg); err == nil {
+				t.Fatal("invalid configuration accepted")
+			}
+		})
+	}
+	if _, err := New(nil, config.NetFlowConfig{Enabled: true}); err == nil {
+		t.Fatal("nil context accepted")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := New(ctx, config.NetFlowConfig{Enabled: true, Listen: "127.0.0.1:0"}); err == nil {
+		t.Fatal("canceled constructor context accepted")
+	}
+	s, err := New(context.Background(), config.NetFlowConfig{Listen: "not-an-address", SampleInterval: -1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	s.OnStartup()
+	s.OnStartup()
+	if !s.Disabled() || s.listener != nil {
+		t.Fatal("disabled sampler bound a listener")
+	}
+	batch, err := s.Sample()
+	if err != nil || len(batch) != 0 {
+		t.Fatalf("disabled sample = %v, %v", batch, err)
+	}
+}
+
+func TestConstructorReportsBindFailure(t *testing.T) {
+	listener, err := net.ListenPacket("udp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	if _, err := New(context.Background(), config.NetFlowConfig{
+		Enabled: true,
+		Listen:  listener.LocalAddr().String(),
+	}); err == nil {
+		t.Fatal("occupied UDP listener was accepted")
+	}
+}
+
+func waitForReceiver(t *testing.T, s *Sampler) {
+	t.Helper()
+	select {
+	case <-s.done:
+	case <-time.After(5 * time.Second):
+		t.Fatal("receiver did not stop after context cancellation")
+	}
+}
+
+func assertCanBind(t *testing.T, address string) {
+	t.Helper()
+	listener, err := net.ListenPacket("udp", address)
+	if err != nil {
+		t.Fatalf("canceled sampler retained its UDP socket: %v", err)
+	}
+	_ = listener.Close()
+}
+
+func TestUDPReceiverDiagnosticsStartupAndCancellation(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	s, err := New(ctx, config.NetFlowConfig{Enabled: true, Listen: "127.0.0.1:0"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	address := s.listener.LocalAddr().(*net.UDPAddr).AddrPort()
+	s.OnStartup()
+	s.OnStartup()
+	sender, err := net.DialUDP("udp", nil, net.UDPAddrFromAddrPort(address))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer sender.Close()
+	packet := exportPacket(0, true)
+	for _, datagram := range [][]byte{packet, packet, exportPacket(1, false), {0, 9}} {
+		if _, err := sender.Write(datagram); err != nil {
+			t.Fatal(err)
+		}
+	}
+	deadline := time.NewTimer(5 * time.Second)
+	defer deadline.Stop()
+	tick := time.NewTicker(time.Millisecond)
+	defer tick.Stop()
+	for {
+		s.mu.Lock()
+		count := s.diagnostics.DatagramsReceived
+		s.mu.Unlock()
+		if count == 4 {
+			break
+		}
+		select {
+		case <-tick.C:
+		case <-deadline.C:
+			t.Fatalf("received %d of 4 UDP datagrams", count)
+		}
+	}
+	cancel()
+	waitForReceiver(t, s)
+	assertCanBind(t, address.String())
+	ips, collector := drain(t, s)
+	if len(ips) != 2 {
+		t.Fatalf("decoded IP count = %d, want 2", len(ips))
+	}
+	assertTraffic(t, ips["192.0.2.1"], 1234, 0, 7, 0, 1)
+	assertTraffic(t, ips["198.51.100.2"], 0, 1234, 0, 7, 1)
+	assertDiagnostics(t, collector, 4, 1, 1, 1, 0, 1, 0)
+}
+
+// exportPacket is an unsampled v9 export with a template and one data record,
+// or an unknown-template data set when includeTemplate is false.
+func exportPacket(sequence uint32, includeTemplate bool) []byte {
+	packet := make([]byte, 20)
+	binary.BigEndian.PutUint16(packet[0:2], 9)
+	binary.BigEndian.PutUint16(packet[2:4], 1)
+	binary.BigEndian.PutUint32(packet[4:8], 1000+sequence)
+	binary.BigEndian.PutUint32(packet[8:12], 1700000000)
+	binary.BigEndian.PutUint32(packet[12:16], sequence)
+	binary.BigEndian.PutUint32(packet[16:20], 1)
+	if includeTemplate {
+		binary.BigEndian.PutUint16(packet[2:4], 2)
+		for _, value := range []uint16{0, 24, 256, 4, 8, 4, 12, 4, 1, 8, 2, 4} {
+			packet = binary.BigEndian.AppendUint16(packet, value)
+		}
+	}
+	templateID := uint16(256)
+	if !includeTemplate {
+		templateID++
+	}
+	packet = binary.BigEndian.AppendUint16(packet, templateID)
+	packet = binary.BigEndian.AppendUint16(packet, 24)
+	packet = append(packet, 192, 0, 2, 1, 198, 51, 100, 2)
+	packet = binary.BigEndian.AppendUint64(packet, 1234)
+	return binary.BigEndian.AppendUint32(packet, 7)
+}
+
+// Ensure both concrete event types participate in the native agent pipeline.
+var (
+	_ sample.Event = (*IPTrafficSample)(nil)
+	_ sample.Event = (*FlowCollectorSample)(nil)
+)
