@@ -0,0 +1,307 @@
+// Copyright 2026 New Relic Corporation. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+// Package netflow collects endpoint-relative traffic deltas from NetFlow v9.
+package netflow
+
+import (
+	"context"
+	"fmt"
+	"net"
+	"net/netip"
+	"sync"
+	"time"
+
+	flow "github.com/newrelic/infrastructure-agent/internal/netflow"
+	"github.com/newrelic/infrastructure-agent/pkg/config"
+	"github.com/newrelic/infrastructure-agent/pkg/log"
+	"github.com/newrelic/infrastructure-agent/pkg/sample"
+)
+
+const (
+	defaultListen         = "127.0.0.1:2055"
+	defaultSampleInterval = 15 * time.Second
+	defaultMaxIPs         = 8192
+)
+
+var collectorLog = log.WithComponent("NetFlowSampler")
+
+// IPTrafficSample contains deltas for one canonical endpoint in one window.
+// A transfer between two tracked endpoints contributes to both endpoints;
+// summing sent and received bytes across endpoints double-counts that transfer.
+type IPTrafficSample struct {
+	sample.BaseEvent
+	IP               string `json:"ip"`
+	ObservationPoint string `json:"observationPoint"`
+	BytesSent        uint64 `json:"bytesSent"`
+	BytesReceived    uint64 `json:"bytesReceived"`
+	PacketsSent      uint64 `json:"packetsSent"`
+	PacketsReceived  uint64 `json:"packetsReceived"`
+	// FlowRecords counts contributing records, once even for a same-IP flow.
+	FlowRecords uint64 `json:"flowRecords"`
+	IntervalMs  int64  `json:"intervalMs"`
+}
+
+// FlowCollectorSample reports collector diagnostics for the same drained window.
+type FlowCollectorSample struct {
+	sample.BaseEvent
+	ObservationPoint   string `json:"observationPoint"`
+	DatagramsReceived  uint64 `json:"datagramsReceived"`
+	RecordsDecoded     uint64 `json:"recordsDecoded"`
+	UnknownTemplates   uint64 `json:"unknownTemplates"`
+	MalformedDatagrams uint64 `json:"malformedDatagrams"`
+	SequenceGaps       uint64 `json:"sequenceGaps"`
+	DuplicateDatagrams uint64 `json:"duplicateDatagrams"`
+	// DroppedIPs counts endpoint updates rejected by MaxIPs, not distinct
+	// rejected addresses. CIDR-excluded endpoints do not count as drops.
+	DroppedIPs uint64 `json:"droppedIPs"`
+	IntervalMs int64  `json:"intervalMs"`
+}
+
+type trafficCounters struct {
+	bytesSent       uint64
+	bytesReceived   uint64
+	packetsSent     uint64
+	packetsReceived uint64
+	flowRecords     uint64
+}
+
+// Sampler owns its UDP listener until its construction context is canceled.
+// Only the receiver goroutine accesses the decoder; the mutex makes complete
+// decoded datagrams and report-window drains atomic with respect to each other.
+type Sampler struct {
+	ctx              context.Context
+	enabled          bool
+	interval         time.Duration
+	maxIPs           int
+	observationPoint string
+	trackedCIDRs     []netip.Prefix
+	listener         *net.UDPConn
+	decoder          *flow.Decoder
+	startOnce        sync.Once
+	done             chan struct{}
+	now              func() time.Time
+
+	mu            sync.Mutex
+	windowStarted time.Time
+	ips           map[netip.Addr]trafficCounters
+	diagnostics   FlowCollectorSample
+}
+
+// New validates enabled configuration and binds the socket before returning,
+// making listen failures visible to the agent's startup path. Disabled samplers
+// do not bind a socket or start any goroutine. Zero-valued settings use defaults.
+func New(ctx context.Context, cfg config.NetFlowConfig) (*Sampler, error) {
+	if ctx == nil {
+		return nil, fmt.Errorf("netflow sampler: context is nil")
+	}
+	s := &Sampler{
+		ctx:              ctx,
+		enabled:          cfg.Enabled,
+		interval:         defaultSampleInterval,
+		maxIPs:           defaultMaxIPs,
+		observationPoint: cfg.ObservationPoint,
+		done:             make(chan struct{}),
+		now:              time.Now,
+		windowStarted:    time.Now(),
+	}
+	if !cfg.Enabled {
+		close(s.done)
+		return s, nil
+	}
+	if cfg.SampleInterval < 0 || time.Duration(cfg.SampleInterval) > time.Duration(1<<63-1)/time.Second {
+		return nil, fmt.Errorf("netflow sampler: sample_interval must be a positive number of seconds")
+	}
+	if cfg.SampleInterval > 0 {
+		s.interval = time.Duration(cfg.SampleInterval) * time.Second
+	}
+	if cfg.MaxIPs < 0 {
+		return nil, fmt.Errorf("netflow sampler: max_ips must be positive")
+	}
+	if cfg.MaxIPs > 0 {
+		s.maxIPs = cfg.MaxIPs
+	}
+	for _, cidr := range cfg.TrackedCIDRs {
+		prefix, err := netip.ParsePrefix(cidr)
+		if err != nil {
+			return nil, fmt.Errorf("netflow sampler: invalid tracked CIDR %q: %w", cidr, err)
+		}
+		if prefix.Addr().Is4In6() && prefix.Bits() >= 96 {
+			prefix = netip.PrefixFrom(prefix.Addr().Unmap(), prefix.Bits()-96)
+		}
+		s.trackedCIDRs = append(s.trackedCIDRs, prefix.Masked())
+	}
+	listen := cfg.Listen
+	if listen == "" {
+		listen = defaultListen
+	}
+	lc := net.ListenConfig{}
+	listener, err := lc.ListenPacket(ctx, "udp", listen)
+	if err != nil {
+		return nil, fmt.Errorf("netflow sampler: listen on %q: %w", listen, err)
+	}
+	udp, ok := listener.(*net.UDPConn)
+	if !ok {
+		_ = listener.Close()
+		return nil, fmt.Errorf("netflow sampler: listener on %q is not UDP", listen)
+	}
+	if err := ctx.Err(); err != nil {
+		_ = udp.Close()
+		return nil, fmt.Errorf("netflow sampler: %w", err)
+	}
+	s.listener = udp
+	s.decoder = flow.NewDecoder()
+	// Cancellation also closes a bound socket if OnStartup was never called.
+	context.AfterFunc(ctx, func() { _ = udp.Close() })
+	return s, nil
+}
+
+func (*Sampler) Name() string { return "NetFlowSampler" }
+
+func (s *Sampler) Interval() time.Duration { return s.interval }
+
+func (s *Sampler) Disabled() bool { return !s.enabled }
+
+// OnStartup starts exactly one receiver, even if the agent invokes it again.
+func (s *Sampler) OnStartup() {
+	s.startOnce.Do(func() {
+		if !s.enabled {
+			return
+		}
+		if s.ctx.Err() != nil {
+			_ = s.listener.Close()
+			close(s.done)
+			return
+		}
+		collectorLog.WithField("listen", s.listener.LocalAddr().String()).Info("Starting NetFlow sampler")
+		go s.receive()
+	})
+}
+
+func (s *Sampler) receive() {
+	defer close(s.done)
+	defer s.listener.Close()
+	var packet [65535]byte
+	for {
+		n, exporter, err := s.listener.ReadFromUDPAddrPort(packet[:])
+		if err != nil {
+			if s.ctx.Err() == nil {
+				collectorLog.WithError(err).Warn("NetFlow receiver stopped")
+			}
+			return
+		}
+		result, err := s.decoder.Decode(exporter, packet[:n], s.now())
+		s.collect(result, err)
+	}
+}
+
+func canonicalIP(addr netip.Addr) netip.Addr {
+	return addr.Unmap().WithZone("")
+}
+
+func (s *Sampler) tracked(addr netip.Addr) bool {
+	if !addr.IsValid() {
+		return false
+	}
+	if len(s.trackedCIDRs) == 0 {
+		return true
+	}
+	for _, prefix := range s.trackedCIDRs {
+		if prefix.Contains(addr) {
+			return true
+		}
+	}
+	return false
+}
+
+// collect commits a whole datagram, including failures, to one report window.
+func (s *Sampler) collect(result flow.Result, decodeErr error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.diagnostics.DatagramsReceived++
+	if decodeErr != nil {
+		s.diagnostics.MalformedDatagrams++
+		return
+	}
+	s.diagnostics.UnknownTemplates += result.UnknownTemplates
+	s.diagnostics.SequenceGaps += result.SequenceGaps
+	if result.Duplicate {
+		s.diagnostics.DuplicateDatagrams++
+		return
+	}
+	s.diagnostics.RecordsDecoded += uint64(len(result.Records))
+	for i := range result.Records {
+		record := &result.Records[i]
+		source := canonicalIP(record.Source)
+		destination := canonicalIP(record.Destination)
+		s.addTraffic(source, record.Bytes, record.Packets, true, source == destination)
+		if destination != source {
+			s.addTraffic(destination, record.Bytes, record.Packets, false, true)
+		}
+	}
+}
+
+// addTraffic runs under mu. Existing endpoints continue accumulating after the
+// window reaches capacity; no unbounded rejected-address set is retained.
+func (s *Sampler) addTraffic(addr netip.Addr, bytes, packets uint64, sent, received bool) {
+	if !s.tracked(addr) {
+		return
+	}
+	counters, exists := s.ips[addr]
+	if !exists {
+		if len(s.ips) >= s.maxIPs {
+			s.diagnostics.DroppedIPs++
+			return
+		}
+		if s.ips == nil {
+			s.ips = make(map[netip.Addr]trafficCounters)
+		}
+	}
+	if sent {
+		counters.bytesSent += bytes
+		counters.packetsSent += packets
+	}
+	if received {
+		counters.bytesReceived += bytes
+		counters.packetsReceived += packets
+	}
+	counters.flowRecords++
+	s.ips[addr] = counters
+}
+
+// Sample drains both traffic and diagnostics. It emits a collector event on
+// every enabled report, but never invents per-IP rows for an idle window.
+func (s *Sampler) Sample() (sample.EventBatch, error) {
+	if !s.enabled {
+		return nil, nil
+	}
+	s.mu.Lock()
+	now := s.now()
+	intervalMs := now.Sub(s.windowStarted).Milliseconds()
+	ips := s.ips
+	diagnostics := s.diagnostics
+	s.ips = nil
+	s.diagnostics = FlowCollectorSample{}
+	s.windowStarted = now
+	s.mu.Unlock()
+
+	batch := make(sample.EventBatch, 0, len(ips)+1)
+	for addr, counters := range ips {
+		event := &IPTrafficSample{
+			IP:               addr.String(),
+			ObservationPoint: s.observationPoint,
+			BytesSent:        counters.bytesSent,
+			BytesReceived:    counters.bytesReceived,
+			PacketsSent:      counters.packetsSent,
+			PacketsReceived:  counters.packetsReceived,
+			FlowRecords:      counters.flowRecords,
+			IntervalMs:       intervalMs,
+		}
+		event.Type("PfIpTrafficSample")
+		batch = append(batch, event)
+	}
+	diagnostics.Type("PfFlowCollectorSample")
+	diagnostics.ObservationPoint = s.observationPoint
+	diagnostics.IntervalMs = intervalMs
+	return append(batch, &diagnostics), nil
+}
