+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestDecodeCapturedSoftflowd111Datagram(t *testing.T) {
+	// Actual softflowd 1.1.1 UDP payload from the isolated routed VNET test:
+	// 1,000 request/reply pairs, independently observed as 2,000 packets by
+	// libpcap and softflowd. This is not a generated NetFlow fixture. It includes
+	// four templates, interface-name options, direction/flow-end fields, and
+	// unaligned FlowSets. Header Count=2 counts only data records (not templates
+	// or options); sequence=1 is a datagram sequence, unlike the 1.0.0 variant.
+	const wire = "AAkAAgAAEBJq1oTNAAAAAQAAAAAAAABIBAAAEAAIAAQADAAEABYABAAVAAQAAQAEAAIABAAKAAQADgAEAD0AAQCIAAEABwACAAsA" +
+		"AgAEAAEABgABADwAAQAFAAEAAABABAEADgAIAAQADAAEABYABAAVAAQAAQAEAAIABAAKAAQADgAEAD0AAQCIAAEAIAACAAQAAQA8AAEABQAB" +
+		"AAAASAgAABAAGwAQABwAEAAWAAQAFQAEAAEABAACAAQACgAEAA4ABAA9AAEAiAABAAcAAgALAAIABAABAAYAAQA8AAEABQAB" +
+		"AAAAQAgBAA4AGwAQABwAEAAWAAQAFQAEAAEABAACAAQACgAEAA4ABAA9AAEAiAABAIsAAgAEAAEAPAABAAUAAQABABoBAAAEAAwA" +
+		"AgAEACIABAAjAAEAUgAQAQAAHQAAAAAAAAABAXRhcDAAAAAAAAAAAAAAAAAEAABZxhIAAsYSAAYAAAfZAAAIOAAPr6AAAAPo" +
+		"AAAAAAAAAAAAAQAAAAAAAAQAxhIABsYSAAIAAAfZAAAIOAAGh+AAAAPoAAAAAAAAAAABAQAAAAAAAAQAAA=="
+	packet, err := base64.StdEncoding.DecodeString(wire)
+	require.NoError(t, err)
+	require.Len(t, packet, 436)
+	decoder := NewDecoder()
+	exporter := netip.MustParseAddrPort("127.0.0.1:48109")
+	got, err := decoder.Decode(exporter, packet, testNow)
+	require.NoError(t, err)
+	source := netip.MustParseAddr("198.18.0.2")
+	destination := netip.MustParseAddr("198.18.0.6")
+	assert.Equal(t, Result{Records: []Record{
+		{Source: source, Destination: destination, Bytes: 1028000, Packets: 1000},
+		{Source: destination, Destination: source, Bytes: 428000, Packets: 1000},
+	}}, got)
+	got, err = decoder.Decode(exporter, packet, testNow.Add(time.Second))
+	require.NoError(t, err)
+	assert.Equal(t, Result{Duplicate: true}, got, "replay must not produce consumer traffic twice")
+}
