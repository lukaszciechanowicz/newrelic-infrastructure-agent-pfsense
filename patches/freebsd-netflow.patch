diff --git a/pkg/metrics/disk_freebsd.go b/pkg/metrics/disk_freebsd.go
new file mode 100644
index 0000000000000000000000000000000000000000..614d4f07a0d9e438a968da30454255fe01ca1954
--- /dev/null
+++ b/pkg/metrics/disk_freebsd.go
@@ -0,0 +1,70 @@
+// Copyright 2026 New Relic Corporation. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package metrics
+
+import (
+	"fmt"
+	"time"
+)
+
+func (m *DiskMonitor) Sample() (*DiskSample, error) {
+	if m.storageSampler == nil {
+		return nil, fmt.Errorf("DiskMonitor is not properly configured with a storage sampler")
+	}
+	result := &DiskSample{}
+	hasSharedCapacity := false
+	for _, fs := range FilterStorageSamples(m.storageSampler.Samples()) {
+		if fs.TotalBytes == nil || fs.UsedBytes == nil || fs.FreeBytes == nil {
+			continue
+		}
+		if fs.FileSystemType == "zfs" {
+			// ZFS datasets share pool capacity; summing statfs totals would
+			// duplicate free space. Per-dataset capacity remains in StorageSample.
+			hasSharedCapacity = true
+			continue
+		}
+		result.capacityAvailable = true
+		result.TotalBytes += *fs.TotalBytes
+		result.UsedBytes += *fs.UsedBytes
+		result.FreeBytes += *fs.FreeBytes
+	}
+	result.capacityAvailable = result.capacityAvailable && !hasSharedCapacity
+	if total := result.UsedBytes + result.FreeBytes; total > 0 {
+		result.UsedPercent = result.UsedBytes / total * 100
+		result.FreePercent = result.FreeBytes / total * 100
+	}
+
+	now := time.Now()
+	current, err := m.storageSampler.SampleWrapper().IOCounters()
+	if err != nil {
+		m.lastIOCounters = nil
+		m.lastIOTime = time.Time{}
+		syslog.WithError(err).Warn("Cannot read FreeBSD disk I/O counters.")
+		return result, nil
+	}
+	elapsedMs := now.Sub(m.lastIOTime).Milliseconds()
+	if !m.lastIOTime.IsZero() && elapsedMs > 0 {
+		count := 0
+		for name, counter := range current {
+			previous, found := m.lastIOCounters[name]
+			if !found {
+				continue
+			}
+			delta := m.storageSampler.SampleWrapper().CalculateSampleValues(counter, previous, elapsedMs)
+			if delta == nil || delta.ReadsPerSec == nil || delta.WritesPerSec == nil || delta.TotalUtilizationPercent == nil {
+				continue
+			}
+			count++
+			result.ReadsPerSec += *delta.ReadsPerSec
+			result.WritesPerSec += *delta.WritesPerSec
+			result.UtilizationPercent += *delta.TotalUtilizationPercent
+		}
+		if count > 0 {
+			result.ioAvailable = true
+			result.UtilizationPercent /= float64(count)
+		}
+	}
+	m.lastIOTime, m.lastIOCounters = now, current
+	return result, nil
+}
