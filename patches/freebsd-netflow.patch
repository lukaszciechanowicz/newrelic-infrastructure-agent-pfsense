new file mode 100644
index 0000000000000000000000000000000000000000..4c71dd859f8435b16dea5e8fe8a132bda2ff75a6
--- /dev/null
+++ b/internal/netflow/sequence.go
@@ -0,0 +1,101 @@
+// Copyright 2020 New Relic Corporation. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package netflow
+
+import (
+	"crypto/sha256"
+	"time"
+)
+
+// sessionChange distinguishes normal uptime/sequence wrap and small packet
+// reordering from a reboot. UNIX seconds disambiguate most old packets. The
+// two-second tolerance covers the header's one-second timestamp precision.
+func sessionChange(state *exporterState, h packetHeader) (reboot, stale bool) {
+	if state == nil {
+		return false, false
+	}
+	uptimeDelta := int64(int32(h.uptime - state.header.uptime))
+	clockDelta := (int64(h.unixSeconds) - int64(state.header.unixSeconds)) * 1000
+	bootAdvance := clockDelta - uptimeDelta
+	if uptimeDelta < 0 && clockDelta >= 0 {
+		sequenceAhead := int32(h.sequence-state.header.sequence) > 0
+		if sequenceAhead || h.sequence <= 1 || bootAdvance > 2000 {
+			return true, false
+		}
+	}
+	// A late datagram from the previous boot must not use the new boot's
+	// templates, even when its sequence looks like a large forward jump.
+	if state.rebooted && uptimeDelta > 0 && bootAdvance < -2000 {
+		return false, true
+	}
+	return false, false
+}
+
+func sequenceChange(state *exporterState, h packetHeader, dataRecords uint32,
+	unknown, reboot bool) (seen, gaps uint64, duplicate, advance bool) {
+	if state == nil || reboot {
+		return 1, 0, false, true
+	}
+	delta := int32(h.sequence - state.header.sequence)
+	if delta > 0 {
+		seen = 1
+		if delta < sequenceWindow {
+			seen |= state.seen << uint32(delta)
+		}
+		if h.recordSequence {
+			if !unknown && uint32(delta) > dataRecords {
+				gaps = uint64(uint32(delta) - dataRecords)
+			}
+		} else {
+			gaps = uint64(delta - 1)
+		}
+		return seen, gaps, false, true
+	}
+	// softflowd can refresh templates without exporting another data record.
+	if delta == 0 && h.recordSequence && dataRecords == 0 {
+		if h.unixSeconds < state.header.unixSeconds || int32(h.uptime-state.header.uptime) < 0 {
+			return state.seen, 0, true, false
+		}
+		return state.seen, 0, false, true
+	}
+	age := state.header.sequence - h.sequence
+	if age >= sequenceWindow || state.seen&(uint64(1)<<age) != 0 {
+		return state.seen, 0, true, false
+	}
+	return state.seen | uint64(1)<<age, 0, false, false
+}
+
+func (state *exporterState) hasFingerprint(fingerprint [sha256.Size]byte) bool {
+	for i := range state.recentCount {
+		if state.recent[i] == fingerprint {
+			return true
+		}
+	}
+	return false
+}
+
+func (state *exporterState) remember(fingerprint [sha256.Size]byte) {
+	state.recent[state.recentNext] = fingerprint
+	state.recentNext = (state.recentNext + 1) % len(state.recent)
+	if state.recentCount < len(state.recent) {
+		state.recentCount++
+	}
+}
+
+func (state *exporterState) applyTemplates(updates map[uint16]flowTemplate, now time.Time) {
+	if len(updates) == 0 {
+		return
+	}
+	for id, template := range state.templates {
+		if !now.Before(template.expires) {
+			delete(state.templates, id)
+		}
+	}
+	if state.templates == nil {
+		state.templates = make(map[uint16]flowTemplate, len(updates))
+	}
+	for id, template := range updates {
+		state.templates[id] = template
+	}
+}
