diff --git a/internal/netflow/decoder.go b/internal/netflow/decoder.go
new file mode 100644
index 0000000000000000000000000000000000000000..ca1ee90a03d0140a89c635c56b729edc828abe7b
--- /dev/null
+++ b/internal/netflow/decoder.go
@@ -0,0 +1,212 @@
+// Copyright 2020 New Relic Corporation. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package netflow
+
+import (
+	"crypto/sha256"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"net/netip"
+	"time"
+)
+
+const (
+	headerSize       = 20
+	maxDatagramSize  = 65535
+	maxExporters     = 128
+	maxTemplates     = 256
+	maxFields        = 128
+	sequenceWindow   = 64
+	templateLifetime = 30 * time.Minute
+	exporterLifetime = 30 * time.Minute
+)
+
+// Record is one unidirectional, unsampled flow delta. Bytes and Packets belong
+// to Source sending to Destination; the decoder never invents a reverse flow.
+type Record struct {
+	Source, Destination netip.Addr
+	Bytes, Packets      uint64
+}
+
+// Result contains only data from one completely accepted datagram.
+type Result struct {
+	Records          []Record
+	UnknownTemplates uint64
+	// SequenceGaps counts missing sequence units, not inferred lost traffic.
+	// Units are datagrams for RFC 3954 and data records for softflowd's
+	// byte-length-Count variant. Unknown templates prevent the latter estimate.
+	SequenceGaps uint64
+	// Duplicate also identifies packets outside the bounded reorder window.
+	Duplicate bool
+}
+
+// Decoder maintains bounded exporter/template/replay state. Decode calls must
+// be serialized by the caller. A zero Decoder is ready for use.
+type Decoder struct {
+	exporters map[exporterKey]*exporterState
+}
+
+type exporterKey struct {
+	address  netip.AddrPort
+	sourceID uint32
+}
+
+type packetHeader struct {
+	uptime, unixSeconds, sequence, sourceID uint32
+	recordSequence                          bool
+}
+
+type exporterState struct {
+	templates               map[uint16]flowTemplate
+	lastSeen                time.Time
+	header                  packetHeader
+	seen                    uint64
+	rebooted                bool
+	recent                  [sequenceWindow][sha256.Size]byte
+	recentCount, recentNext int
+}
+
+type transaction struct {
+	base        *exporterState
+	now         time.Time
+	updates     map[uint16]flowTemplate
+	result      Result
+	dataRecords uint32
+}
+
+// NewDecoder creates a NetFlow version 9 decoder without external dependencies.
+func NewDecoder() *Decoder {
+	return &Decoder{exporters: make(map[exporterKey]*exporterState)}
+}
+
+// Decode rejects malformed datagrams atomically: both Result and all decoder
+// state remain unchanged on error. exporter includes the UDP source port.
+func (d *Decoder) Decode(exporter netip.AddrPort, packet []byte, now time.Time) (Result, error) {
+	h, err := readHeader(exporter, packet)
+	if err != nil {
+		return Result{}, err
+	}
+	key := exporterKey{address: exporter, sourceID: h.sourceID}
+	state := d.exporters[key]
+	if state != nil && !now.Before(state.lastSeen.Add(exporterLifetime)) {
+		state = nil
+	}
+	fingerprint := sha256.Sum256(packet)
+	if state != nil && state.hasFingerprint(fingerprint) {
+		return Result{Duplicate: true}, nil
+	}
+	reboot, stale := sessionChange(state, h)
+	tx := transaction{base: state, now: now}
+	if reboot {
+		tx.base = nil
+	}
+	if err := tx.parse(packet[headerSize:]); err != nil {
+		return Result{}, err
+	}
+	seen, gaps, duplicate, advance := sequenceChange(state, h, tx.dataRecords,
+		tx.result.UnknownTemplates != 0, reboot)
+	if duplicate || stale {
+		return Result{Duplicate: true}, nil
+	}
+	if state == nil {
+		if d.activeExporters(now) >= maxExporters {
+			return Result{}, errors.New("netflow: exporter limit exceeded")
+		}
+		d.expireExporters(now)
+		if d.exporters == nil {
+			d.exporters = make(map[exporterKey]*exporterState)
+		}
+		state = &exporterState{lastSeen: now}
+		d.exporters[key] = state
+	}
+	if reboot {
+		state.templates = nil
+		state.rebooted = true
+	}
+	// Reordered template refreshes may decode this datagram, but must never
+	// replace a newer definition or extend its lifetime in the shared cache.
+	if advance {
+		state.applyTemplates(tx.updates, now)
+		state.header = h
+	}
+	state.seen = seen
+	if now.After(state.lastSeen) {
+		state.lastSeen = now
+	}
+	state.remember(fingerprint)
+	tx.result.SequenceGaps = gaps
+	return tx.result, nil
+}
+
+func readHeader(exporter netip.AddrPort, packet []byte) (packetHeader, error) {
+	if !exporter.IsValid() {
+		return packetHeader{}, errors.New("netflow: invalid exporter address")
+	}
+	if len(packet) < headerSize || len(packet) > maxDatagramSize {
+		return packetHeader{}, errors.New("netflow: invalid datagram length")
+	}
+	if binary.BigEndian.Uint16(packet) != 9 {
+		return packetHeader{}, errors.New("netflow: only version 9 is supported")
+	}
+	return packetHeader{
+		uptime:      binary.BigEndian.Uint32(packet[4:8]),
+		unixSeconds: binary.BigEndian.Uint32(packet[8:12]),
+		sequence:    binary.BigEndian.Uint32(packet[12:16]),
+		sourceID:    binary.BigEndian.Uint32(packet[16:20]),
+		// softflowd 1.0.0's default v9 sender aliases an IPFIX header here:
+		// Count is the datagram byte length and sequence counts data records.
+		recordSequence: int(binary.BigEndian.Uint16(packet[2:4])) == len(packet),
+	}, nil
+}
+
+func (tx *transaction) parse(payload []byte) error {
+	if len(payload) == 0 {
+		return errors.New("netflow: datagram has no FlowSets")
+	}
+	for len(payload) != 0 {
+		if len(payload) < 4 {
+			return errors.New("netflow: truncated FlowSet header")
+		}
+		id := binary.BigEndian.Uint16(payload)
+		length := int(binary.BigEndian.Uint16(payload[2:4]))
+		if length < 4 || length > len(payload) {
+			return errors.New("netflow: invalid FlowSet length")
+		}
+		body := payload[4:length]
+		var err error
+		switch {
+		case id == 0:
+			err = tx.parseTemplates(body, false)
+		case id == 1:
+			err = tx.parseTemplates(body, true)
+		case id >= 256:
+			err = tx.parseData(id, body)
+			// Reserved FlowSets are opaque, but their framing is still validated.
+		}
+		if err != nil {
+			return fmt.Errorf("netflow: FlowSet %d: %w", id, err)
+		}
+		payload = payload[length:]
+	}
+	return nil
+}
+
+func (d *Decoder) activeExporters(now time.Time) int {
+	count := 0
+	for _, state := range d.exporters {
+		if now.Before(state.lastSeen.Add(exporterLifetime)) {
+			count++
+		}
+	}
+	return count
+}
+
+func (d *Decoder) expireExporters(now time.Time) {
+	for key, state := range d.exporters {
+		if !now.Before(state.lastSeen.Add(exporterLifetime)) {
+			delete(d.exporters, key)
+		}
+	}
+}
diff --git a/internal/netflow/decoder_test.go b/internal/netflow/decoder_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..8682ec4bc878e7c821fae7acdc84df3e568e2866
--- /dev/null
+++ b/internal/netflow/decoder_test.go
@@ -0,0 +1,300 @@
+// Copyright 2020 New Relic Corporation. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package netflow
+
+import (
+	"encoding/binary"
+	"math"
+	"net/netip"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+type testField struct {
+	kind, length uint16
+}
+
+var (
+	testExporter = netip.MustParseAddrPort("192.0.2.100:2055")
+	testNow      = time.Date(2026, time.January, 1, 0, 0, 0, 0, time.UTC)
+	ipv4Fields   = []testField{{8, 4}, {12, 4}, {1, 4}, {2, 4}}
+)
+
+func TestDecodeCounterWidthsAndFamilies(t *testing.T) {
+	widths := []struct {
+		width          uint16
+		bytes, packets uint64
+	}{
+		{1, 0xf1, 0xa2},
+		{2, 0xff01, 0xabcd},
+		{4, 0xfedcba98, 0xf1234567},
+		{8, math.MaxUint64, 1<<63 + 123},
+	}
+	families := []struct {
+		name, source, destination           string
+		sourceKind, destinationKind, length uint16
+	}{
+		{"IPv4", "192.0.2.10", "198.51.100.20", 8, 12, 4},
+		{"IPv6", "2001:db8:1::10", "2001:db8:2::20", 27, 28, 16},
+		{"mapped IPv6", "::ffff:192.0.2.10", "::ffff:198.51.100.20", 27, 28, 16},
+	}
+	for _, family := range families {
+		for _, width := range widths {
+			t.Run(family.name+"/"+string(rune('0'+width.width)), func(t *testing.T) {
+				fields := []testField{
+					{900, 3}, {2, width.width}, {family.destinationKind, family.length},
+					{901, 7}, {1, width.width}, {family.sourceKind, family.length}, {902, 1},
+				}
+				source := netip.MustParseAddr(family.source)
+				destination := netip.MustParseAddr(family.destination)
+				data := testData(fields, source, destination, width.bytes, width.packets)
+				packet := testPacket(1, 10000, 1, testSet(0, testTemplate(1024, fields)),
+					testSet(1024, data, []byte{0, 0, 0}))
+				got, err := NewDecoder().Decode(testExporter, packet, testNow)
+				require.NoError(t, err)
+				assert.Equal(t, Result{Records: []Record{{
+					Source: source.Unmap(), Destination: destination.Unmap(),
+					Bytes: width.bytes, Packets: width.packets,
+				}}}, got)
+			})
+		}
+	}
+}
+
+func TestDecodeSoftflowdLayouts(t *testing.T) {
+	// Field orders come from softflowd-1.0.0 netflow9.c (legacy) and ipfix.c
+	// (the default v9 sender), not a synthetic fixed-layout decoder contract.
+	// https://github.com/irino/softflowd/tree/softflowd-1.0.0
+	cases := []struct {
+		name                string
+		id                  uint16
+		fields              []testField
+		source, destination string
+		bytes, packets      uint64
+	}{
+		{
+			"legacy IPv4", 1024,
+			[]testField{{8, 4}, {12, 4}, {21, 4}, {22, 4}, {1, 4}, {2, 4},
+				{10, 4}, {14, 4}, {7, 2}, {11, 2}, {4, 1}, {6, 1}, {60, 1}, {5, 1}, {32, 2}, {58, 2}},
+			"192.0.2.10", "198.51.100.20", 314159, 211,
+		},
+		{
+			"default IPv4 transport", 1024,
+			[]testField{{8, 4}, {12, 4}, {22, 4}, {21, 4}, {1, 4}, {2, 4},
+				{10, 4}, {14, 4}, {7, 2}, {11, 2}, {4, 1}, {6, 1}, {60, 1}, {5, 1}},
+			"192.0.2.11", "198.51.100.21", 1073741825, 65538,
+		},
+		{
+			"default IPv4 ICMP", 1025,
+			[]testField{{8, 4}, {12, 4}, {22, 4}, {21, 4}, {1, 4}, {2, 4},
+				{10, 4}, {14, 4}, {32, 2}, {60, 1}, {5, 1}},
+			"192.0.2.12", "198.51.100.22", 168, 2,
+		},
+		{
+			"default IPv6 transport with VLAN and MAC", 2048,
+			[]testField{{27, 16}, {28, 16}, {152, 8}, {153, 8}, {1, 4}, {2, 4},
+				{10, 4}, {14, 4}, {7, 2}, {11, 2}, {4, 1}, {6, 1}, {60, 1}, {5, 1},
+				{58, 2}, {59, 2}, {56, 6}, {57, 6}},
+			"2001:db8:1::13", "2001:db8:2::23", 4000000000, 123456,
+		},
+		{
+			"default IPv6 ICMP", 2049,
+			[]testField{{27, 16}, {28, 16}, {22, 4}, {21, 4}, {1, 4}, {2, 4},
+				{10, 4}, {14, 4}, {139, 2}, {60, 1}, {5, 1}},
+			"2001:db8:1::14", "2001:db8:2::24", 256, 2,
+		},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			source := netip.MustParseAddr(tc.source)
+			destination := netip.MustParseAddr(tc.destination)
+			forward := testData(tc.fields, source, destination, tc.bytes, tc.packets)
+			reverse := testData(tc.fields, destination, source, 1234, 7)
+			packet := testPacket(2, 10000, 0, testSet(0, testTemplate(tc.id, tc.fields)),
+				testSet(tc.id, forward, reverse))
+			got, err := NewDecoder().Decode(testExporter, packet, testNow)
+			require.NoError(t, err)
+			assert.Equal(t, Result{Records: []Record{
+				{Source: source, Destination: destination, Bytes: tc.bytes, Packets: tc.packets},
+				{Source: destination, Destination: source, Bytes: 1234, Packets: 7},
+			}}, got)
+		})
+	}
+}
+
+func TestDecodeOptionsReservedSetsAndIncompleteTemplates(t *testing.T) {
+	cases := []struct {
+		name string
+		sets [][]byte
+		want Result
+	}{
+		{
+			"softflowd unaligned options", [][]byte{
+				testSet(1, testOptions(256, []testField{{2, 4}}, []testField{{34, 4}, {35, 1}})),
+				testSet(256, []byte{0, 0, 0, 1, 0, 0, 0, 1, 1}),
+				testSet(0, testTemplate(1024, ipv4Fields)),
+				testSet(1024, sampleIPv4Data(12345, 42), []byte{0}),
+			}, Result{Records: []Record{sampleIPv4Record(12345, 42)}},
+		},
+		{
+			"multiple options templates and padding", [][]byte{
+				testSet(1, testOptions(256, []testField{{1, 4}}, []testField{{34, 4}, {35, 1}}),
+					testOptions(257, []testField{{1, 4}}, []testField{{1, 8}}), []byte{0, 0}),
+				testSet(256, make([]byte, 9), []byte{0, 0, 0}), testSet(257, make([]byte, 12)),
+			}, Result{},
+		},
+		{
+			"missing counters are not fake zero records", [][]byte{
+				testSet(0, testTemplate(1024, []testField{{8, 4}, {12, 4}, {900, 4}})),
+				testSet(1024, make([]byte, 12)),
+			}, Result{},
+		},
+		{
+			"missing endpoints are not fake addresses", [][]byte{
+				testSet(0, testTemplate(1024, []testField{{1, 4}, {2, 4}})),
+				testSet(1024, make([]byte, 8)),
+			}, Result{},
+		},
+		{
+			"unknown fields and reserved sets are opaque", [][]byte{
+				testSet(42, []byte{255, 7, 8}), testSet(0, testTemplate(1024, ipv4Fields), []byte{0, 0}),
+				testSet(1024, sampleIPv4Data(0, 0)),
+			}, Result{Records: []Record{sampleIPv4Record(0, 0)}},
+		},
+		{
+			"unknown templates count FlowSets not invented records", [][]byte{
+				testSet(1024, make([]byte, 32)), testSet(2048, []byte{1, 2, 3}),
+			}, Result{UnknownTemplates: 2},
+		},
+		{
+			"unknown data before definition is never retrospectively fabricated", [][]byte{
+				testSet(1024, sampleIPv4Data(100, 2)), testSet(0, testTemplate(1024, ipv4Fields)),
+				testSet(1024, sampleIPv4Data(300, 4)),
+			}, Result{UnknownTemplates: 1, Records: []Record{sampleIPv4Record(300, 4)}},
+		},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := NewDecoder().Decode(testExporter, testPacket(1, 10000, 0, tc.sets...), testNow)
+			require.NoError(t, err)
+			assert.Equal(t, tc.want, got)
+		})
+	}
+}
+
+func TestDecodeCopiesNoInputStorage(t *testing.T) {
+	decoder := NewDecoder()
+	packet := testPacket(1, 10000, 0, testSet(0, testTemplate(1024, ipv4Fields)),
+		testSet(1024, sampleIPv4Data(987654321, 15)))
+	got, err := decoder.Decode(testExporter, packet, testNow)
+	require.NoError(t, err)
+	clear(packet)
+	assert.Equal(t, []Record{sampleIPv4Record(987654321, 15)}, got.Records)
+	got, err = decoder.Decode(testExporter, testPacket(2, 10000, 0,
+		testSet(1024, sampleIPv4Data(1234, 7))), testNow)
+	require.NoError(t, err)
+	assert.Equal(t, Result{Records: []Record{sampleIPv4Record(1234, 7)}}, got)
+}
+
+func testPacket(sequence, uptime, sourceID uint32, sets ...[]byte) []byte {
+	packet := make([]byte, headerSize)
+	binary.BigEndian.PutUint16(packet, 9)
+	binary.BigEndian.PutUint16(packet[2:4], uint16(len(sets)))
+	binary.BigEndian.PutUint32(packet[4:8], uptime)
+	binary.BigEndian.PutUint32(packet[8:12], uint32(testNow.Unix()))
+	binary.BigEndian.PutUint32(packet[12:16], sequence)
+	binary.BigEndian.PutUint32(packet[16:20], sourceID)
+	for _, set := range sets {
+		packet = append(packet, set...)
+	}
+	return packet
+}
+
+func testSet(id uint16, bodies ...[]byte) []byte {
+	set := make([]byte, 4)
+	binary.BigEndian.PutUint16(set, id)
+	for _, body := range bodies {
+		set = append(set, body...)
+	}
+	binary.BigEndian.PutUint16(set[2:4], uint16(len(set)))
+	return set
+}
+
+func testTemplate(id uint16, fields []testField) []byte {
+	body := make([]byte, 4)
+	binary.BigEndian.PutUint16(body, id)
+	binary.BigEndian.PutUint16(body[2:4], uint16(len(fields)))
+	return appendTestFields(body, fields)
+}
+
+func testOptions(id uint16, scopes, fields []testField) []byte {
+	body := make([]byte, 6)
+	binary.BigEndian.PutUint16(body, id)
+	binary.BigEndian.PutUint16(body[2:4], uint16(len(scopes)*4))
+	binary.BigEndian.PutUint16(body[4:6], uint16(len(fields)*4))
+	return appendTestFields(appendTestFields(body, scopes), fields)
+}
+
+func appendTestFields(body []byte, fields []testField) []byte {
+	for _, field := range fields {
+		body = binary.BigEndian.AppendUint16(body, field.kind)
+		body = binary.BigEndian.AppendUint16(body, field.length)
+	}
+	return body
+}
+
+func testData(fields []testField, source, destination netip.Addr, bytes, packets uint64) []byte {
+	var data []byte
+	for _, field := range fields {
+		value := make([]byte, int(field.length))
+		switch field.kind {
+		case 8, 27:
+			copy(value, source.AsSlice())
+		case 12, 28:
+			copy(value, destination.AsSlice())
+		case 1, 2:
+			number := bytes
+			if field.kind == 2 {
+				number = packets
+			}
+			for i := range int(field.length) {
+				value[i] = byte(number >> (8 * (int(field.length) - i - 1)))
+			}
+		default:
+			for i := range len(value) {
+				value[i] = byte(int(field.kind) + i)
+			}
+		}
+		data = append(data, value...)
+	}
+	return data
+}
+
+func sampleIPv4Data(bytes, packets uint64) []byte {
+	return testData(ipv4Fields, netip.MustParseAddr("192.0.2.10"),
+		netip.MustParseAddr("198.51.100.20"), bytes, packets)
+}
+
+func sampleIPv4Record(bytes, packets uint64) Record {
+	return Record{Source: netip.MustParseAddr("192.0.2.10"),
+		Destination: netip.MustParseAddr("198.51.100.20"), Bytes: bytes, Packets: packets}
+}
+
+func snapshotDecoder(decoder *Decoder) *Decoder {
+	copy := &Decoder{exporters: make(map[exporterKey]*exporterState, len(decoder.exporters))}
+	for key, state := range decoder.exporters {
+		cloned := *state
+		if state.templates != nil {
+			cloned.templates = make(map[uint16]flowTemplate, len(state.templates))
+			for id, template := range state.templates {
+				cloned.templates[id] = template
+			}
+		}
+		copy.exporters[key] = &cloned
+	}
+	return copy
+}
