@@ -0,0 +1,176 @@
+// Copyright 2020 New Relic Corporation. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package netflow
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestDecodeTemplateLifetimeIsDefinitionBased(t *testing.T) {
+	for _, action := range []string{"data", "duplicate", "definition"} {
+		t.Run(action, func(t *testing.T) {
+			decoder := NewDecoder()
+			original := testPacket(1, 10000, 0, testSet(0, testTemplate(1024, ipv4Fields)),
+				testSet(1024, sampleIPv4Data(100, 1)))
+			_, err := decoder.Decode(testExporter, original, testNow)
+			require.NoError(t, err)
+			_, err = decoder.Decode(testExporter, testPacket(2, 10000, 0,
+				testSet(1024, sampleIPv4Data(200, 2))), testNow.Add(templateLifetime/2))
+			require.NoError(t, err)
+			packet := testPacket(3, 10000, 0, testSet(1024, sampleIPv4Data(300, 3)))
+			querySequence := uint32(4)
+			switch action {
+			case "duplicate":
+				packet = original
+				querySequence = 3
+			case "definition":
+				packet = testPacket(3, 10000, 0, testSet(0, testTemplate(1024, ipv4Fields)))
+			}
+			_, err = decoder.Decode(testExporter, packet, testNow.Add(templateLifetime-time.Second))
+			require.NoError(t, err)
+			got, err := decoder.Decode(testExporter, testPacket(querySequence, 10000, 0,
+				testSet(1024, sampleIPv4Data(1234, 7))), testNow.Add(templateLifetime))
+			require.NoError(t, err)
+			if action == "definition" {
+				assert.Equal(t, Result{Records: []Record{sampleIPv4Record(1234, 7)}}, got)
+			} else {
+				assert.Equal(t, Result{UnknownTemplates: 1}, got)
+			}
+		})
+	}
+}
+
+func TestDecodeExporterExpirationBoundary(t *testing.T) {
+	for _, elapsed := range []time.Duration{exporterLifetime - time.Nanosecond, exporterLifetime} {
+		t.Run(elapsed.String(), func(t *testing.T) {
+			var decoder Decoder
+			_, err := decoder.Decode(testExporter, testPacket(100, 10000, 0,
+				testSet(0, testTemplate(1024, ipv4Fields))), testNow)
+			require.NoError(t, err)
+			got, err := decoder.Decode(testExporter, testPacket(200, 10000, 0,
+				testSet(1024, sampleIPv4Data(1234, 7))), testNow.Add(elapsed))
+			require.NoError(t, err)
+			if elapsed < exporterLifetime {
+				assert.Equal(t, Result{Records: []Record{sampleIPv4Record(1234, 7)}, SequenceGaps: 99}, got)
+			} else {
+				assert.Equal(t, Result{UnknownTemplates: 1}, got)
+			}
+		})
+	}
+}
+
+func TestDecodeExporterBoundDoesNotEvictActiveSenders(t *testing.T) {
+	decoder := NewDecoder()
+	for id := range maxExporters {
+		got, err := decoder.Decode(testExporter, testPacket(1, 10000, uint32(id),
+			testSet(0, testTemplate(1024, ipv4Fields))), testNow)
+		require.NoError(t, err)
+		assert.Equal(t, Result{}, got)
+	}
+	require.Len(t, decoder.exporters, maxExporters)
+	before := snapshotDecoder(decoder)
+	packet := testPacket(1, 10000, maxExporters, testSet(0, testTemplate(1024, ipv4Fields)),
+		testSet(1024, sampleIPv4Data(1234, 7)))
+	got, err := decoder.Decode(testExporter, packet, testNow)
+	require.Error(t, err)
+	assert.Equal(t, Result{}, got)
+	assert.Equal(t, before, decoder)
+	got, err = decoder.Decode(testExporter, testPacket(2, 10000, 0,
+		testSet(1024, sampleIPv4Data(1234, 7))), testNow)
+	require.NoError(t, err)
+	assert.Equal(t, Result{Records: []Record{sampleIPv4Record(1234, 7)}}, got)
+	got, err = decoder.Decode(testExporter, packet, testNow.Add(exporterLifetime))
+	require.NoError(t, err)
+	assert.Equal(t, Result{Records: []Record{sampleIPv4Record(1234, 7)}}, got)
+	assert.Len(t, decoder.exporters, 1, "expired scopes are reclaimed before adding a sender")
+}
+
+func TestDecodeTemplateBoundAndExpiredCapacity(t *testing.T) {
+	decoder := NewDecoder()
+	var body []byte
+	for id := range maxTemplates {
+		body = append(body, testTemplate(uint16(256+id), []testField{{900, 1}})...)
+	}
+	got, err := decoder.Decode(testExporter, testPacket(1, 10000, 0, testSet(0, body)), testNow)
+	require.NoError(t, err)
+	assert.Equal(t, Result{}, got)
+	key := exporterKey{address: testExporter}
+	require.Len(t, decoder.exporters[key].templates, maxTemplates)
+	before := snapshotDecoder(decoder)
+	got, err = decoder.Decode(testExporter, testPacket(2, 10000, 0,
+		testSet(0, testTemplate(1024, ipv4Fields))), testNow)
+	require.Error(t, err)
+	assert.Equal(t, Result{}, got)
+	assert.Equal(t, before, decoder)
+	// Refreshing a live ID consumes no additional capacity, including when
+	// several duplicate definitions of that ID occur in the same FlowSet.
+	got, err = decoder.Decode(testExporter, testPacket(2, 10000, 0,
+		testSet(0, testTemplate(256, ipv4Fields), testTemplate(256, ipv4Fields)),
+		testSet(256, sampleIPv4Data(1234, 7))), testNow)
+	require.NoError(t, err)
+	assert.Equal(t, Result{Records: []Record{sampleIPv4Record(1234, 7)}}, got)
+	assert.Len(t, decoder.exporters[key].templates, maxTemplates)
+	_, err = decoder.Decode(testExporter, testPacket(3, 10000, 0, testSet(42, []byte{1})),
+		testNow.Add(templateLifetime-time.Second))
+	require.NoError(t, err)
+	got, err = decoder.Decode(testExporter, testPacket(4, 10000, 0,
+		testSet(0, testTemplate(1024, ipv4Fields)), testSet(1024, sampleIPv4Data(1234, 7))),
+		testNow.Add(templateLifetime))
+	require.NoError(t, err)
+	assert.Equal(t, Result{Records: []Record{sampleIPv4Record(1234, 7)}}, got)
+	assert.Len(t, decoder.exporters[key].templates, 1)
+}
+
+func TestDecodeMaximumFieldAndDatagramBoundaries(t *testing.T) {
+	cases := []struct {
+		name   string
+		fields []testField
+		data   []byte
+	}{
+		{"maximum record length", []testField{{900, maxDatagramSize - headerSize - 4}},
+			make([]byte, maxDatagramSize-headerSize-4)},
+		{"maximum field count", make([]testField, maxFields), make([]byte, maxFields)},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			if tc.name == "maximum field count" {
+				for i := range tc.fields {
+					tc.fields[i] = testField{uint16(900 + i), 1}
+				}
+			}
+			decoder := NewDecoder()
+			_, err := decoder.Decode(testExporter, testPacket(1, 10000, 0,
+				testSet(0, testTemplate(1024, tc.fields))), testNow)
+			require.NoError(t, err)
+			got, err := decoder.Decode(testExporter, testPacket(2, 10000, 0,
+				testSet(1024, tc.data)), testNow)
+			require.NoError(t, err)
+			assert.Equal(t, Result{}, got, "unrecognized fields must not fabricate counters")
+		})
+	}
+}
+
+func TestDecodeMaximumAccountingRecordCount(t *testing.T) {
+	fields := []testField{{8, 4}, {12, 4}, {1, 1}, {2, 1}}
+	record := sampleIPv4Record(200, 123)
+	data := testData(fields, record.Source, record.Destination, record.Bytes, record.Packets)
+	count := (maxDatagramSize - headerSize - 4) / len(data)
+	var body []byte
+	want := make([]Record, count)
+	for i := range count {
+		body = append(body, data...)
+		want[i] = record
+	}
+	decoder := NewDecoder()
+	_, err := decoder.Decode(testExporter, testPacket(1, 10000, 0,
+		testSet(0, testTemplate(1024, fields))), testNow)
+	require.NoError(t, err)
+	got, err := decoder.Decode(testExporter, testPacket(2, 10000, 0, testSet(1024, body)), testNow)
+	require.NoError(t, err)
+	assert.Equal(t, Result{Records: want}, got)
+}
